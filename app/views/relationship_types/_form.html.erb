<%= form_with model: [ project, relationship_type ], local: true do |f| %>
  <% if relationship_type.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% relationship_type.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <%# What this kind of edge connects, and in which direction. Both ends are
      required: they are what makes an edge checkable rather than just labelled. %>
  <div class="row g-2 mb-3">
    <div class="col-sm-6">
      <%= f.label :from_entity_type_id, "From", class: "form-label" %>
      <%= f.collection_select :from_entity_type_id, project.entity_types, :id, :name,
                              { prompt: "Choose an entity type" },
                              class: "form-select", required: true %>
    </div>
    <div class="col-sm-6">
      <%= f.label :to_entity_type_id, "To", class: "form-label" %>
      <%= f.collection_select :to_entity_type_id, project.entity_types, :id, :name,
                              { prompt: "Choose an entity type" },
                              class: "form-select", required: true %>
    </div>
    <div class="form-text">
      An edge of this kind may only run from the first to the second. The same type on
      both ends is fine.
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 3 %>
    <div class="form-text">
      Used as the context for extracting relationships of this type from source material. Write it for
      the model that will read it: what counts as one, and what does not.
    </div>
  </div>


  <%# A type is its name, its description and what it carries. Editing those one
      field at a time across three screens is what made defining a type feel
      heavier than it is. %>
  <hr class="my-4">
  <h2 class="h5">Attributes</h2>

  <div data-controller="nested-fields"
       data-nested-fields-start-index-value="<%= relationship_type.relationship_type_attributes.size %>">
    <div data-nested-fields-target="list">
      <%= f.fields_for :relationship_type_attributes do |af| %>
        <%= render "shared/type_attribute_fields", f: af %>
      <% end %>
    </div>

    <%# The blank row's markup lives here rather than in JavaScript, so it
        cannot drift from the rows rendered above it. %>
    <template data-nested-fields-target="template">
      <%= f.fields_for :relationship_type_attributes, RelationshipTypeAttribute.new, child_index: "NEW_RECORD" do |af| %>
        <%= render "shared/type_attribute_fields", f: af %>
      <% end %>
    </template>

    <%= link_to "Add attribute", "#", class: "btn btn-sm btn-outline-primary",
                data: { action: "click->nested-fields#add" } %>
  </div>

  <hr class="my-4">

  <%= f.submit submit_label, class: "btn btn-primary" %>
  <%= link_to "Cancel", structure_project_path(project), class: "btn btn-outline-secondary" %>
<% end %>
