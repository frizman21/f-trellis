<% content_for :title, "Learning Sets" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Learning Sets</h1>
  <%= link_to "New learning set", new_learning_set_path, class: "btn btn-primary" %>
</div>

<p class="text-muted">
  A named collection of pages — the set you come back to when you want to know
  whether something works. A set only groups sources; it never fetches or
  processes them.
</p>

<% if @learning_sets.any? %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Sources</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @learning_sets.each do |learning_set| %>
        <tr>
          <td><%= link_to learning_set.name, learning_set_path(learning_set) %></td>
          <td><%= truncate(learning_set.description.to_s, length: 100) %></td>
          <td><%= learning_set.source_count %></td>
          <td><%= link_to "Edit", edit_learning_set_path(learning_set), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No learning sets yet.</p>
  <p><%= link_to "Create the first one", new_learning_set_path, class: "btn btn-primary" %></p>
<% end %>
