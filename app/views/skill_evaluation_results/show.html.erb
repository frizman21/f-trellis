<% content_for :title, "Result ##{@result.id}" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Result #<%= @result.id %></h1>
  <%= evaluation_status_badge(@result.status) %>
</div>

<p class="text-muted">
  <%= link_to @evaluation.name, skill_evaluation_path(@evaluation) %> —
  <%= @evaluation.skill.name %>, revision <%= @result.skill_revision.sequence %>.
</p>

<dl class="row">
  <dt class="col-sm-3">Source</dt>
  <dd class="col-sm-9">
    <%= link_to "##{@result.source.id}", source_path(@result.source) %>
    <%= external_link_to truncate(@result.source.url.to_s, length: 80), @result.source.url %>
  </dd>

  <dt class="col-sm-3">Model</dt>
  <dd class="col-sm-9">
    <span class="text-muted"><%= @result.model.provider %> /</span>
    <code><%= @result.model.model_id %></code>
    <% if @result.model_id == @evaluation.base_model_id %>
      <span class="badge bg-light text-dark">baseline</span>
    <% end %>
  </dd>

  <dt class="col-sm-3">Skill revision</dt>
  <dd class="col-sm-9">
    <%= link_to "revision #{@result.skill_revision.sequence}", skill_revision_path(@result.skill_revision) %>
  </dd>

  <dt class="col-sm-3">Contribution</dt>
  <dd class="col-sm-9">
    <%= evaluation_score_label(@result) %>
    <span class="text-muted small">
      distinct entities and relationships this run would have added.
    </span>
    <% if @baseline && @baseline.id != @result.id && @result.same_proposals_as?(@baseline) %>
      <span class="badge bg-info text-dark">identical to the baseline</span>
    <% end %>
  </dd>

  <dt class="col-sm-3">Chat</dt>
  <dd class="col-sm-9">
    <%= @result.chat ? link_to("Chat ##{@result.chat.id}", chat_path(@result.chat)) : "—" %>
  </dd>

  <dt class="col-sm-3">Timing</dt>
  <dd class="col-sm-9">
    <% if @result.duration_seconds %>
      <%= number_with_precision(@result.duration_seconds, precision: 1) %>s
    <% else %>
      —
    <% end %>
  </dd>
</dl>

<% if @result.error.present? %>
  <div class="alert alert-danger">
    <strong>Failed.</strong> <%= @result.error %>
  </div>
<% end %>

<h2 class="h4">Proposals</h2>

<%# The run's proposals beside the baseline's, split three ways. Nothing here
    was written to the graph — an evaluation runs recording stand-ins for the
    upsert tools, so this is what the run *would* have added. %>
<% if @result.status == "complete" %>
  <% if @baseline.nil? || @baseline.id == @result.id %>
    <% if @result.proposal_set.empty? %>
      <p class="text-muted">This run proposed nothing.</p>
    <% else %>
      <ul>
        <% @result.proposal_set.distinct.each do |record| %>
          <li><%= proposal_line(record) %></li>
        <% end %>
      </ul>
    <% end %>
    <% if @baseline.nil? %>
      <p class="text-muted small">
        The baseline has not run on this page at this revision, so there is
        nothing to compare against yet.
      </p>
    <% end %>
  <% else %>
    <% mine = @result.proposal_set %>
    <% base = @baseline.proposal_set %>
    <% agreement = EvaluationComparison::Agreement.new(
         agreed: mine.shared_with(base).size,
         missed: mine.missing_from(base).size,
         invented: mine.added_over(base).size,
         pages: 1) %>
    <p>
      Agreement <strong><%= agreement_percentage(agreement.f1) %></strong> —
      recall <%= agreement_percentage(agreement.recall) %>,
      precision <%= agreement_percentage(agreement.precision) %>
      <span class="text-muted small">on this page.</span>
    </p>
    <div class="row">
      <div class="col-md-4">
        <h3 class="h6">Agreed with the baseline (<%= agreement.agreed %>)</h3>
        <ul class="small"><% mine.shared_with(base).each do |r| %><li><%= proposal_line(r) %></li><% end %></ul>
      </div>
      <div class="col-md-4">
        <h3 class="h6">Invented — not in the baseline (<%= agreement.invented %>)</h3>
        <ul class="small"><% mine.added_over(base).each do |r| %><li><%= proposal_line(r) %></li><% end %></ul>
      </div>
      <div class="col-md-4">
        <h3 class="h6">Missed, that the baseline found (<%= agreement.missed %>)</h3>
        <ul class="small"><% mine.missing_from(base).each do |r| %><li><%= proposal_line(r) %></li><% end %></ul>
      </div>
    </div>
    <p class="text-muted small">
      Compared against <%= link_to "the baseline's run on this page", skill_evaluation_result_path(@baseline) %>
      (<code><%= @evaluation.base_model.model_id %></code>), which defines correctness
      here. "Invented" means the baseline did not back it up — on a page the baseline
      read incompletely, some of it may be right. Nothing here was written to the
      knowledge graph — an evaluation runs recording stand-ins for the upsert tools.
    </p>
  <% end %>
<% else %>
  <p class="text-muted">Nothing proposed — this run has not completed.</p>
<% end %>

<h2 class="h4">Response</h2>
<% if @result.response.present? %>
  <pre class="p-3 bg-light border rounded" style="white-space: pre-wrap;"><%= @result.response %></pre>
<% else %>
  <p class="text-muted">
    <%= @result.status == "pending" ? "Queued — nothing returned yet." : "No response recorded." %>
  </p>
<% end %>

<p><%= link_to "Back to evaluation", skill_evaluation_path(@evaluation) %></p>
