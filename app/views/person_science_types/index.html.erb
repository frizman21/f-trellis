<% content_for :title, "Person ↔ Science Types" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Person ↔ Science Types</h1>
  <%= link_to "New relationship type", new_person_science_type_path, class: "btn btn-primary" %>
</div>

<% if @person_science_types.any? %>
  <table class="table">
    <thead><tr><th>Name</th><th>Description</th><th>Additional attribute keys</th><th></th></tr></thead>
    <tbody>
      <% @person_science_types.each do |type| %>
        <tr>
          <td><%= type.name %></td>
          <td><%= type.description %></td>
          <td><%= type.additional_attribute_keys.join(", ") %></td>
          <td><%= link_to "Edit", edit_person_science_type_path(type), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No relationship types defined.</p>
<% end %>
