<%= form_with model: @research_starting_point, local: true do |f| %>
  <% if @research_starting_point.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @research_starting_point.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :url, class: "form-label" %>
    <%= f.url_field :url,
                    value: f.object.url,
                    class: "form-control",
                    required: true,
                    placeholder: "https://example.com/feed" %>
  </div>

  <div class="mb-3">
    <%= f.label :frequency, class: "form-label" %>
    <%= f.select :frequency,
                 ResearchStartingPoint::FREQUENCIES.map { |freq| [ResearchStartingPoint::FREQUENCY_LABELS[freq], freq] },
                 {},
                 class: "form-select",
                 required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 3 %>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :is_enabled, class: "form-check-input" %>
    <%= f.label :is_enabled, "Enabled", class: "form-check-label" %>
    <div class="form-text">Disabled starting points are skipped by the scheduler.</div>
  </div>

  <%= f.submit class: "btn btn-primary" %>
  <%= link_to "Cancel", research_starting_points_path, class: "btn btn-outline-secondary" %>
<% end %>
