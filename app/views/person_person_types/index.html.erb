<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Person ↔ Person Types</h1>
  <%= link_to "New relationship type", new_person_person_type_path, class: "btn btn-primary" %>
</div>

<% if @person_person_types.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Additional attribute keys</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @person_person_types.each do |ppt| %>
        <tr>
          <td><%= ppt.name %></td>
          <td><%= ppt.description %></td>
          <td><%= ppt.additional_attribute_keys.join(", ") %></td>
          <td><%= link_to "Edit", edit_person_person_type_path(ppt), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No relationship types defined.</p>
<% end %>
