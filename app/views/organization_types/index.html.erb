<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Organization Types</h1>
  <%= link_to "New organization type", new_organization_type_path, class: "btn btn-primary" %>
</div>

<% if @organization_types.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Additional attribute keys</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @organization_types.each do |ot| %>
        <tr>
          <td><%= ot.name %></td>
          <td><%= ot.description %></td>
          <td><%= ot.additional_attribute_keys.join(", ") %></td>
          <td><%= link_to "Edit", edit_organization_type_path(ot), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No organization types defined.</p>
<% end %>
