<% content_for :title, "Sciences" %>
<h1>Sciences</h1>

<%= form_with url: sciences_path, method: :get, local: true, class: "mb-3" do |f| %>
  <div class="input-group">
    <%= f.text_field :q, value: @query, placeholder: "Search names, summaries or attribute values...", class: "form-control" %>
    <%= f.submit "Search", class: "btn btn-primary" %>
    <% if @query.present? %>
      <%= link_to "Clear", sciences_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
<% end %>

<% searching = @query.present? %>

<% if @sciences.any? %>
  <p class="text-muted small">
    Showing <%= @sciences.size %> of <%= @sciences.total_count %>.
  </p>

  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th><%= searching ? "Matched on" : "Types" %></th>
      </tr>
    </thead>
    <tbody>
      <% @sciences.each do |science| %>
        <% detail = science.current_detail %>
        <tr>
          <td>
            <%= link_to (detail ? detail.name : "Unnamed science ##{science.id}"), science %>
          </td>
          <td>
            <% if searching %>
              <% reasons = @match_reasons[science.id] || [] %>
              <% if reasons.any? %>
                <ul class="mb-0">
                  <% reasons.each do |r| %>
                    <li><%= r %></li>
                  <% end %>
                </ul>
              <% end %>
            <% else %>
              <%= detail&.science_types&.map(&:name)&.join(", ") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @sciences %>
<% else %>
  <p>
    <% if searching %>
      No sciences matched <em><%= @query %></em>.
    <% else %>
      No sciences yet.
    <% end %>
  </p>
<% end %>
