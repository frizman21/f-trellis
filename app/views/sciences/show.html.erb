<% current = @science.current_detail %>
<% content_for :title, (current ? current.name : "Unnamed science ##{@science.id}") %>

<h1><%= current ? current.name : "Unnamed science ##{@science.id}" %></h1>

<% if current %>
  <% if current.summary.present? %>
    <p class="lead"><%= current.summary %></p>
  <% end %>

  <dl>
    <dt>As of</dt><dd><%= current.as_of&.to_date %></dd>
    <dt>Confidence</dt><dd><%= current.confidence_tenths.to_i / 10.0 %>%</dd>
    <% if current.science_types.any? %>
      <dt>Types</dt><dd><%= current.science_types.map(&:name).join(", ") %></dd>
    <% end %>
  </dl>

  <% if current.additional_attributes.any? %>
    <h2>Attributes</h2>
    <table class="table table-sm">
      <tbody>
        <% current.additional_attributes.each do |key, value| %>
          <tr><th><%= key.humanize %></th><td><%= value %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>

<% prior = @science.science_details.where.not(id: current&.id).order(as_of: :desc) %>
<% if prior.any? %>
  <h2>Prior details</h2>
  <table class="table">
    <thead>
      <tr><th>Name</th><th>Summary</th><th>As of</th><th>Confidence</th><th>Attributes</th></tr>
    </thead>
    <tbody>
      <% prior.each do |d| %>
        <tr>
          <td><%= d.name %></td>
          <td><%= d.summary %></td>
          <td><%= d.as_of&.to_date %></td>
          <td><%= d.confidence_tenths.to_i / 10.0 %>%</td>
          <td>
            <% if d.additional_attributes.any? %>
              <%= d.additional_attributes.map { |k, v| "#{k.humanize}: #{v}" }.join("; ") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% technologies = @science.science_technologies.includes(:technology, current_detail: :science_technology_types) %>
<%= render "shared/relationship_table",
      title: "Technologies",
      column_header: "Technology",
      empty_message: "No technologies recorded for this science.",
      rows: technologies.map { |st|
        tech_detail = st.technology.current_detail
        rel_detail = st.current_detail
        {
          name: tech_detail ? tech_detail.name : "Technology ##{st.technology_id}",
          record: st.technology,
          types: rel_detail&.science_technology_types&.map(&:name)&.join(", "),
          as_of: rel_detail&.as_of,
          relationship_path: science_technology_path(st)
        }
      } %>

<% people = @science.person_sciences.includes(:person, current_detail: :person_science_types) %>
<%= render "shared/relationship_table",
      title: "People",
      column_header: "Person",
      empty_message: "No people recorded for this science.",
      rows: people.map { |ps|
        person_detail = ps.person.current_detail
        rel_detail = ps.current_detail
        {
          name: person_detail ? "#{person_detail.first_name} #{person_detail.last_name}" : "Person ##{ps.person_id}",
          record: ps.person,
          types: rel_detail&.person_science_types&.map(&:name)&.join(", "),
          as_of: rel_detail&.as_of,
          relationship_path: person_science_path(ps)
        }
      } %>

<p><%= link_to "Back to sciences", sciences_path %></p>
