<h1>Person Types</h1>

<% if @person_types.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Additional attribute keys</th>
      </tr>
    </thead>
    <tbody>
      <% @person_types.each do |pt| %>
        <tr>
          <td><%= pt.name %></td>
          <td><%= pt.description %></td>
          <td><%= pt.additional_attribute_keys.join(", ") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No person types defined.</p>
<% end %>
