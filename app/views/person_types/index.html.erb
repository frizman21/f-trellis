<% content_for :title, "Person Types" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Person Types</h1>
  <%= link_to "New person type", new_person_type_path, class: "btn btn-primary" %>
</div>

<% if @person_types.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Additional attribute keys</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @person_types.each do |pt| %>
        <tr>
          <td><%= pt.name %></td>
          <td><%= pt.description %></td>
          <td><%= pt.additional_attribute_keys.join(", ") %></td>
          <td><%= link_to "Edit", edit_person_type_path(pt), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No person types defined.</p>
<% end %>
