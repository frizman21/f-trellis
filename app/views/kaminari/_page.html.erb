<li class="page-item <%= "active" if page.current? %>">
  <% if page.current? %>
    <span class="page-link"><%= page %><span class="visually-hidden"> (current)</span></span>
  <% else %>
    <%= link_to page, url, remote: remote, rel: page.next? ? "next" : (page.prev? ? "prev" : nil), class: "page-link" %>
  <% end %>
</li>
