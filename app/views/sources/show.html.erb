<% content_for :title, "Source ##{@source.id}" %>
<h1>Source #<%= @source.id %></h1>

<dl>
  <dt>URL</dt>
  <dd><%= external_link_to @source.url, @source.url %></dd>

  <% if @source.resolved_url.present? %>
    <dt>Served from</dt>
    <dd>
      <%= external_link_to @source.resolved_url, @source.resolved_url %>
      <span class="text-muted">(this page redirects)</span>
    </dd>
  <% end %>

  <dt>Domain</dt>
  <dd>
    <% if @source.domain %>
      <%= link_to @source.domain.host, domain_path(@source.domain) %>
    <% else %>
      —
    <% end %>
  </dd>

  <dt>Description</dt>
  <dd><%= @source.description.presence || "—" %></dd>

  <dt>Parent source</dt>
  <dd>
    <% if @source.parent_source %>
      <%= link_to "Source ##{@source.parent_source.id}", source_path(@source.parent_source) %>
      — <%= @source.parent_source.url %>
    <% else %>
      — <span class="text-muted">(entered directly, not discovered by a crawl or extraction)</span>
    <% end %>
  </dd>

  <dt>Status</dt>
  <dd>
    <%= @source.status %>
    <%= button_to @source.status == "new" ? "Fetch content" : "Re-fetch content",
                  fetch_source_path(@source),
                  method: :post,
                  form_class: "d-inline ms-2",
                  class: "btn btn-sm btn-primary" %>
  </dd>

  <dt>Learning sets</dt>
  <dd>
    <% if @source.learning_sets.any? %>
      <% @source.learning_sets.order(:name).each do |learning_set| %>
        <div><%= link_to learning_set.name, learning_set_path(learning_set) %></div>
      <% end %>
    <% else %>
      — <span class="text-muted">(not in any set)</span>
    <% end %>

    <% if @learning_sets.any? %>
      <%= form_with url: add_to_learning_set_source_path(@source), method: :post, local: true,
                    class: "d-flex gap-2 mt-2", style: "max-width: 30rem;" do %>
        <%= select_tag :learning_set_id,
                       options_from_collection_for_select(@learning_sets, :id, :name),
                       include_blank: "— add to a learning set —", class: "form-select form-select-sm" %>
        <%= submit_tag "Add", class: "btn btn-sm btn-outline-primary" %>
      <% end %>
    <% else %>
      <div class="form-text">
        No learning sets yet — <%= link_to "create one", new_learning_set_path %>.
      </div>
    <% end %>
  </dd>

  <dt>Created</dt>
  <dd><%= @source.created_at %></dd>

  <dt>Updated</dt>
  <dd><%= @source.updated_at %></dd>
</dl>

<h2>Processing</h2>

<p>
  <% if @source.source_data.any? %>
    <%= link_to "Suggest skills", triage_source_path(@source), class: "btn btn-primary" %>
    <span class="form-text ms-2">
      One cheap call reads each skill's applicability and picks the ones worth
      running on this page.
    </span>
  <% else %>
    <span class="text-muted">
      Fetch this source's content before running skills against it.
    </span>
  <% end %>
</p>

<% if @reports.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Report</th>
        <th>Status</th>
        <th>Skill</th>
        <th>Revision</th>
        <th>Model</th>
        <th>Content</th>
        <th>Chat</th>
        <th>Facts</th>
        <th>Created</th>
      </tr>
    </thead>
    <tbody>
      <% @reports.each do |report| %>
        <tr>
          <td>#<%= report.id %></td>
          <td><%= report_status_cell(report) %></td>
          <td><%= report.skill_revision&.skill&.name || "—" %></td>
          <td>
            <% if report.skill_revision %>
              <%= link_to "rev #{report.skill_revision.sequence}", skill_revision_path(report.skill_revision) %>
            <% else %>
              —
            <% end %>
          </td>
          <td><%= report.model&.model_id || "—" %></td>
          <td>
            <%# Whether this run still covers the page. A report is refused when
                one already covers (source, skill revision, content), so a
                superseded row is the one that can be run again. %>
            <% if report.content_hash.blank? %>
              —
            <% elsif report.content_hash == @current_content_hash %>
              <span class="text-success">Current</span>
            <% else %>
              <span class="text-muted" title="The page has been re-fetched with different content since this ran.">
                Superseded
              </span>
            <% end %>
          </td>
          <td>
            <% if report.chat %>
              <%= link_to "Chat ##{report.chat.id}", chat_path(report.chat) %>
            <% else %>
              —
            <% end %>
          </td>
          <td><%= report.facts.is_a?(Array) ? report.facts.size : (report.facts.is_a?(Hash) ? report.facts.keys.size : 0) %></td>
          <td><%= report.created_at&.to_date %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No skills have been run against this page yet.</p>
<% end %>

<h2>Link graph</h2>

<p>
  <%= link_to "Links from this source (#{@links_from_count})",
              links_from_source_path(@source),
              class: "btn btn-outline-secondary" %>
  <%= link_to "Links to this source (#{@links_to_count})",
              links_to_source_path(@source),
              class: "btn btn-outline-secondary ms-2" %>
</p>

<h2>Crawl from this source</h2>

<%= form_with url: crawl_source_path(@source), method: :post, local: true, class: "mb-4" do |f| %>
  <div class="row g-3 align-items-end">
    <div class="col-md-4">
      <%= f.label :crawl_type, "Crawl type", class: "form-label" %>
      <%= f.select :crawl_type,
                   [["Stay in domain", "stay_in_domain"], ["Follow external links", "follow_external_links"]],
                   {},
                   class: "form-select" %>
    </div>
    <div class="col-md-2">
      <%= f.label :max_depth, "Depth", class: "form-label" %>
      <%= f.number_field :max_depth, value: 1, min: 0, max: 10, step: 1, class: "form-control" %>
    </div>
    <div class="col-md-3">
      <%= f.label :max_pages, "Max pages", class: "form-label" %>
      <%= f.number_field :max_pages, value: CrawlJob::DEFAULT_MAX_PAGES, min: 1, max: CrawlJob::MAX_MAX_PAGES, step: 1, class: "form-control" %>
    </div>
    <div class="col-md-3">
      <%= f.submit "Start crawl", class: "btn btn-primary" %>
    </div>
  </div>
  <div class="form-text">
    Depth 0 only fetches this page. Stay-in-domain follows links only on
    <code><%= @source.domain&.host %></code>. Already-known URLs are skipped.
  </div>
<% end %>

<h2>Source Data</h2>

<p class="form-text">
  Each fetch adds a new zipped payload rather than replacing the last one, so
  re-fetching keeps the earlier copies. Extraction and processing always use
  the most recent.
</p>

<% if @source.source_data.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Content type</th>
        <th>Size</th>
        <th>Created</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @source.source_data.order(:created_at).each do |datum| %>
        <tr>
          <td><%= datum.id %></td>
          <td><%= datum.content_type %></td>
          <td><%= number_to_human_size(datum.data&.bytesize.to_i) %></td>
          <td><%= datum.created_at&.to_date %></td>
          <td>
            <%= link_to "Download", download_source_datum_path(datum) %>
            <%= button_to "Extract links",
                          extract_links_source_datum_path(datum),
                          method: :post,
                          form_class: "d-inline ms-2",
                          class: "btn btn-sm btn-outline-secondary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No source data attached yet.</p>
<% end %>

<p><%= link_to "Back to sources", sources_path %></p>
