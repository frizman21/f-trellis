<% content_for :title, "Source ##{@source.id}" %>
<h1>Source #<%= @source.id %></h1>

<dl>
  <dt>URL</dt>
  <dd><%= external_link_to @source.url, @source.url %></dd>

  <dt>Description</dt>
  <dd><%= @source.description.presence || "—" %></dd>

  <dt>Parent source</dt>
  <dd>
    <% if @source.parent_source %>
      <%= link_to "Source ##{@source.parent_source.id}", source_path(@source.parent_source) %>
      — <%= @source.parent_source.url %>
    <% else %>
      — <span class="text-muted">(entered directly, not discovered by a crawl or extraction)</span>
    <% end %>
  </dd>

  <dt>Status</dt>
  <dd>
    <%= @source.status %>
    <%= button_to @source.status == "new" ? "Fetch content" : "Re-fetch content",
                  fetch_source_path(@source),
                  method: :post,
                  form_class: "d-inline ms-2",
                  class: "btn btn-sm btn-primary" %>
  </dd>

  <dt>Created</dt>
  <dd><%= @source.created_at %></dd>

  <dt>Updated</dt>
  <dd><%= @source.updated_at %></dd>
</dl>

<h2>Processing</h2>

<p>
  <% if @source.source_data.any? %>
    <%= link_to "Suggest skills", triage_source_path(@source), class: "btn btn-primary" %>
    <span class="form-text ms-2">
      One cheap call reads each skill's applicability and picks the ones worth
      running on this page.
    </span>
  <% else %>
    <span class="text-muted">
      Fetch this source's content before running skills against it.
    </span>
  <% end %>
</p>

<h2>Link graph</h2>

<p>
  <%= link_to "Links from this source (#{@links_from_count})",
              links_from_source_path(@source),
              class: "btn btn-outline-secondary" %>
  <%= link_to "Links to this source (#{@links_to_count})",
              links_to_source_path(@source),
              class: "btn btn-outline-secondary ms-2" %>
</p>

<h2>Crawl from this source</h2>

<%= form_with url: crawl_source_path(@source), method: :post, local: true, class: "mb-4" do |f| %>
  <div class="row g-3 align-items-end">
    <div class="col-md-4">
      <%= f.label :crawl_type, "Crawl type", class: "form-label" %>
      <%= f.select :crawl_type,
                   [["Stay in domain", "stay_in_domain"], ["Follow external links", "follow_external_links"]],
                   {},
                   class: "form-select" %>
    </div>
    <div class="col-md-2">
      <%= f.label :max_depth, "Depth", class: "form-label" %>
      <%= f.number_field :max_depth, value: 1, min: 0, max: 10, step: 1, class: "form-control" %>
    </div>
    <div class="col-md-3">
      <%= f.label :max_pages, "Max pages", class: "form-label" %>
      <%= f.number_field :max_pages, value: CrawlJob::DEFAULT_MAX_PAGES, min: 1, max: CrawlJob::MAX_MAX_PAGES, step: 1, class: "form-control" %>
    </div>
    <div class="col-md-3">
      <%= f.submit "Start crawl", class: "btn btn-primary" %>
    </div>
  </div>
  <div class="form-text">
    Depth 0 only fetches this page. Stay-in-domain follows links only on
    <code><%= @source.domain&.host %></code>. Already-known URLs are skipped.
  </div>
<% end %>

<h2>Source Data</h2>

<p class="form-text">
  Each fetch adds a new zipped payload rather than replacing the last one, so
  re-fetching keeps the earlier copies. Extraction and processing always use
  the most recent.
</p>

<% if @source.source_data.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Content type</th>
        <th>Size</th>
        <th>Created</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @source.source_data.order(:created_at).each do |datum| %>
        <tr>
          <td><%= datum.id %></td>
          <td><%= datum.content_type %></td>
          <td><%= number_to_human_size(datum.data&.bytesize.to_i) %></td>
          <td><%= datum.created_at&.to_date %></td>
          <td>
            <%= link_to "Download", download_source_datum_path(datum) %>
            <%= button_to "Extract links",
                          extract_links_source_datum_path(datum),
                          method: :post,
                          form_class: "d-inline ms-2",
                          class: "btn btn-sm btn-outline-secondary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No source data attached yet.</p>
<% end %>

<p><%= link_to "Back to sources", sources_path %></p>
