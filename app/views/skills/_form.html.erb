<% content_for :head do %>
  <link rel="stylesheet" href="https://unpkg.com/easymde/dist/easymde.min.css">
  <script src="https://unpkg.com/easymde/dist/easymde.min.js" defer></script>
<% end %>

<%= form_with model: skill, local: true do |f| %>
  <% if skill.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% skill.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :purpose, class: "form-label" %>
    <%= f.text_field :purpose, class: "form-control" %>
  </div>

  <div class="mb-3">
    <%= f.label :applicability, "Applicability", class: "form-label" %>
    <%= f.text_area :applicability, rows: 4, class: "form-control" %>
    <div class="form-text">
      Which pages this skill is worth running on, and which it is not — e.g.
      "LinkedIn profile pages for individual people; not company pages, not
      search results." Read by triage to decide which skills to call on a page,
      so state it the way you would explain it to someone deciding. Required
      once the skill is active.
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :url_patterns_text, "URL patterns", class: "form-label" %>
    <%= f.text_area :url_patterns_text, rows: 4, class: "form-control font-monospace",
                    placeholder: "linkedin\\.com/in/" %>
    <div class="form-text">
      One regular expression per line. If any of them matches a page's URL, this
      skill is run on that page and no other skill is — the URL settles it, so
      triage skips the model call entirely. Matched anywhere in the URL and case
      insensitively; escape dots (<code>linkedin\.com/in/</code>). Leave blank to
      route this skill by its applicability statement alone, and keep patterns
      narrow: a broad one (<code>.*</code>) claims every page from every other skill.
    </div>
  </div>

  <div class="form-check mb-3">
    <%= f.check_box :is_active, class: "form-check-input" %>
    <%= f.label :is_active, "Active", class: "form-check-label" %>
    <div class="form-text">
      An active skill must state its applicability.
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :preferred_model_id, "Preferred model", class: "form-label" %>
    <%= f.select :preferred_model_id,
                 grouped_options_for_select(
                   models.group_by(&:provider).transform_values { |ms| ms.map { |m| [ model_dropdown_label(m), m.id ] } },
                   skill.preferred_model_id
                 ),
                 { include_blank: "— none —" },
                 { class: "form-select" } %>
    <div class="form-text">Auto-selected when this skill is chosen on a new processing report.</div>
  </div>

  <div class="mb-3">
    <%= f.label :revision_content, "Revision content (Markdown)", class: "form-label" %>
    <%= f.text_area :revision_content,
                    value: revision_content,
                    rows: 10,
                    class: "form-control skill-revision-editor" %>
    <div class="form-text">Saving creates a new revision with this content.</div>
  </div>

  <%= f.submit submit_label, class: "btn btn-primary" %>
  <%= link_to "Cancel", skill.persisted? ? skill_path(skill) : skills_path, class: "btn btn-outline-secondary" %>
<% end %>

<script>
  (function() {
    function initializeSkillRevisionEditor() {
      if (typeof EasyMDE === "undefined") return;

      var textarea = document.querySelector(".skill-revision-editor");
      if (!textarea) return;

      // Skip if EasyMDE has already wrapped this textarea.
      if (textarea.nextElementSibling &&
          textarea.nextElementSibling.classList.contains("EasyMDEContainer")) {
        return;
      }

      new EasyMDE({
        element: textarea,
        spellChecker: false,
        autofocus: false,
        minHeight: "240px",
        status: ["lines", "words"],
        toolbar: [
          "bold", "italic", "heading", "|",
          "quote", "unordered-list", "ordered-list", "|",
          "link", "code", "|",
          "preview", "side-by-side", "fullscreen", "|",
          "guide"
        ]
      });
    }

    document.addEventListener("DOMContentLoaded", initializeSkillRevisionEditor);
    document.addEventListener("turbo:load", initializeSkillRevisionEditor);
    document.addEventListener("turbo:frame-load", initializeSkillRevisionEditor);
    // EasyMDE loads with `defer`, so it may arrive after DOMContentLoaded fires.
    window.addEventListener("load", initializeSkillRevisionEditor);
  })();
</script>
