<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Skills</h1>
  <%= link_to "New skill", new_skill_path, class: "btn btn-primary" %>
</div>

<% if @skills.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Purpose</th>
        <th>Active</th>
        <th>Revisions</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @skills.each do |skill| %>
        <tr>
          <td><%= link_to skill.name, skill_path(skill) %></td>
          <td><%= skill.purpose %></td>
          <td><%= skill.is_active? ? "Yes" : "No" %></td>
          <td><%= skill.revision_count %></td>
          <td><%= link_to "Edit", edit_skill_path(skill), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No skills yet.</p>
<% end %>
