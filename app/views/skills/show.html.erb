<% content_for :title, @skill.name %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0"><%= @skill.name %></h1>
  <%= link_to "Edit", edit_skill_path(@skill), class: "btn btn-primary" %>
</div>

<dl>
  <dt>Purpose</dt>
  <dd><%= @skill.purpose.presence || "—" %></dd>

  <dt>Applicability</dt>
  <dd>
    <% if @skill.applicability.present? %>
      <%= simple_format @skill.applicability, {}, sanitize: true %>
    <% else %>
      — <span class="text-muted">(not stated; triage cannot route this skill)</span>
    <% end %>
  </dd>

  <dt>URL patterns</dt>
  <dd>
    <% if @skill.url_patterns.present? %>
      <% @skill.url_patterns.each do |pattern| %>
        <div><code><%= pattern %></code></div>
      <% end %>
      <div class="text-muted small">
        A page whose URL matches any of these is routed to this skill alone,
        without a triage call.
      </div>
    <% else %>
      — <span class="text-muted">(routed by the applicability statement)</span>
    <% end %>
  </dd>

  <dt>Active</dt>
  <dd><%= @skill.is_active? ? "Yes" : "No" %></dd>

  <dt>Preferred model</dt>
  <dd>
    <% if @skill.preferred_model %>
      <span class="text-muted"><%= @skill.preferred_model.provider %> /</span>
      <code><%= @skill.preferred_model.model_id %></code>
      <% pricing = model_pricing_label(@skill.preferred_model) %>
      <% if pricing %>
        <span class="text-muted small"><%= pricing %></span>
      <% end %>
    <% else %>
      —
    <% end %>
  </dd>

  <dt>Revisions</dt>
  <dd><%= @revisions.size %></dd>
</dl>

<% central = "Central Time (US & Canada)" %>
<% fmt = "%Y-%m-%d %H:%M %Z" %>

<% if @current_revision %>
  <h2>
    Current revision
    <small class="text-muted">#<%= @current_revision.sequence %></small>
  </h2>
  <p class="text-muted small">
    Created <%= @current_revision.created_at.in_time_zone(central).strftime(fmt) %>.
    Model: <%= @current_revision.model&.model_id || "not recorded" %>.
    <%= link_to "Open", skill_revision_path(@current_revision) %>
  </p>
  <pre class="p-3 bg-light border rounded"><%= @current_revision.content %></pre>
<% end %>

<% if @revisions.size > 1 %>
  <h2>Prior revisions</h2>
  <table class="table">
    <thead>
      <tr>
        <th>#</th>
        <th>Model</th>
        <th>Created</th>
      </tr>
    </thead>
    <tbody>
      <% @revisions.drop(1).each do |r| %>
        <tr>
          <td><%= link_to r.sequence, skill_revision_path(r), class: "btn btn-sm btn-outline-primary" %></td>
          <td><%= r.model&.model_id || "—" %></td>
          <td><%= r.created_at.in_time_zone(central).strftime(fmt) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<p><%= link_to "Back to skills", skills_path %></p>
