<% content_for :title, "Edit #{@skill.name}" %>
<h1>Edit Skill: <%= @skill.name %></h1>

<p class="text-muted small">Saving will add a new revision; prior revisions are preserved.</p>

<%= render "form",
           skill: @skill,
           revision_content: @revision_content,
           submit_label: "Save and add revision" %>
