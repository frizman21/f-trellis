<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Part ↔ Part Types</h1>
  <%= link_to "New relationship type", new_part_part_type_path, class: "btn btn-primary" %>
</div>

<% if @part_part_types.any? %>
  <table class="table">
    <thead><tr><th>Name</th><th>Description</th><th>Additional attribute keys</th><th></th></tr></thead>
    <tbody>
      <% @part_part_types.each do |ppt| %>
        <tr>
          <td><%= ppt.name %></td>
          <td><%= ppt.description %></td>
          <td><%= ppt.additional_attribute_keys.join(", ") %></td>
          <td><%= link_to "Edit", edit_part_part_type_path(ppt), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No relationship types defined.</p>
<% end %>
