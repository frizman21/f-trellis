<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for?(:title) ? "#{strip_tags(content_for(:title))} - Trellis" : "Trellis" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="App">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <link rel="stylesheet" href="/bootstrap/bootstrap.min.css">
    <script src="/bootstrap/bootstrap.bundle.min.js" defer></script>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <nav class="navbar navbar-dark bg-dark">
      <div class="container-fluid">
        <a class="navbar-brand" href="/">Trellis</a>
        <div class="d-flex align-items-center">
          <%# Which commit is running. Pushes to main deploy themselves, so this
              is how you tell whether yours has landed yet. %>
          <%= running_version_badge %>

          <% if user_signed_in? %>
            <span class="text-light small me-3"><%= current_user.email %></span>
            <%= button_to "Sign out", destroy_user_session_path, method: :delete, class: "btn btn-sm btn-outline-light", form: { class: "m-0" } %>
          <% else %>
            <%= link_to "Sign in", new_user_session_path, class: "btn btn-sm btn-outline-light" %>
          <% end %>
        </div>
      </div>
    </nav>

    <div class="container-fluid">
      <div class="row">
        <% if user_signed_in? %>
        <nav class="col-md-3 col-lg-2 d-md-block bg-light sidebar" style="min-height: calc(100vh - 56px);">
          <div class="position-sticky pt-3">
            <h6 class="sidebar-heading px-3 mt-3 mb-1 text-muted text-uppercase small">Knowledge</h6>
            <ul class="nav flex-column">
              <li class="nav-item">
                <%= link_to "People", people_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Organizations", organizations_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Facilities", facilities_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Parts", parts_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Sciences", sciences_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Technologies", technologies_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Contracts", contracts_path, class: "nav-link" %>
              </li>
            </ul>

            <h6 class="sidebar-heading px-3 mt-4 mb-1 text-muted text-uppercase small">Types</h6>
            <ul class="nav flex-column">
              <li class="nav-item">
                <%= link_to "Person Types", person_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Organization Types", organization_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Facility Types", facility_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Part Types", part_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Science Types", science_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Technology Types", technology_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Contract Types", contract_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Person ↔ Organization Types", person_organization_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Person ↔ Person Types", person_person_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Organization ↔ Organization Types", organization_organization_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Part ↔ Organization Types", part_organization_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Part ↔ Part Types", part_part_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Part ↔ Technology Types", part_technology_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Science ↔ Technology Types", science_technology_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Person ↔ Science Types", person_science_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Organization ↔ Technology Types", organization_technology_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Contract ↔ Organization Types", contract_organization_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Contract ↔ Person Types", contract_person_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Contract ↔ Technology Types", contract_technology_types_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Contract ↔ Part Types", contract_part_types_path, class: "nav-link" %>
              </li>
            </ul>

            <h6 class="sidebar-heading px-3 mt-4 mb-1 text-muted text-uppercase small">Research</h6>
            <ul class="nav flex-column">
              <li class="nav-item">
                <%= link_to "Starting Points", research_starting_points_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Sources", sources_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Source Imports", source_imports_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Domains", domains_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Source Exclusions", source_exclusions_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Skills", skills_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Triage", triage_configuration_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Learning Sets", learning_sets_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Skill Evaluations", skill_evaluations_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Processing Reports", source_processing_reports_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Chats", chats_path, class: "nav-link" %>
              </li>
              <li class="nav-item">
                <%= link_to "Models", models_path, class: "nav-link" %>
              </li>
            </ul>
          </div>
        </nav>
        <% end %>

        <main class="<%= user_signed_in? ? "col-md-9 ms-sm-auto col-lg-10 px-md-4 py-4" : "col-12 px-md-4 py-4" %>">
          <% if flash[:notice].present? %>
            <div class="alert alert-success" role="alert"><%= flash[:notice] %></div>
          <% end %>
          <% if flash[:alert].present? %>
            <div class="alert alert-warning" role="alert"><%= flash[:alert] %></div>
          <% end %>
          <%= yield %>
        </main>
      </div>
    </div>
  </body>
</html>
