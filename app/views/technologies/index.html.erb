<% content_for :title, "Technologies" %>
<h1>Technologies</h1>

<%= form_with url: technologies_path, method: :get, local: true, class: "mb-3" do |f| %>
  <div class="input-group">
    <%= f.text_field :q, value: @query, placeholder: "Search names, summaries or attribute values...", class: "form-control" %>
    <%= f.submit "Search", class: "btn btn-primary" %>
    <% if @query.present? %>
      <%= link_to "Clear", technologies_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
<% end %>

<% searching = @query.present? %>

<% if @technologies.any? %>
  <p class="text-muted small">
    Showing <%= @technologies.size %> of <%= @technologies.total_count %>.
  </p>

  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th><%= searching ? "Matched on" : "Types" %></th>
      </tr>
    </thead>
    <tbody>
      <% @technologies.each do |technology| %>
        <% detail = technology.current_detail %>
        <tr>
          <td>
            <%= link_to (detail ? detail.name : "Unnamed technology ##{technology.id}"), technology %>
          </td>
          <td>
            <% if searching %>
              <% reasons = @match_reasons[technology.id] || [] %>
              <% if reasons.any? %>
                <ul class="mb-0">
                  <% reasons.each do |r| %>
                    <li><%= r %></li>
                  <% end %>
                </ul>
              <% end %>
            <% else %>
              <%= detail&.technology_types&.map(&:name)&.join(", ") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @technologies %>
<% else %>
  <p>
    <% if searching %>
      No technologies matched <em><%= @query %></em>.
    <% else %>
      No technologies yet.
    <% end %>
  </p>
<% end %>
