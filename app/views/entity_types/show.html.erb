<% content_for :title, @entity_type.name %>
<%= render "projects/back", project: @project, side: :structure %>

<div class="d-flex justify-content-between align-items-center mb-1">
  <h1 class="mb-0"><%= @entity_type.name %></h1>
  <div>
    <%= link_to "Edit", edit_project_entity_type_path(@project, @entity_type), class: "btn btn-sm btn-outline-primary" %>
    <%= button_to "Delete", project_entity_type_path(@project, @entity_type), method: :delete,
                  class: "btn btn-sm btn-outline-danger",
                  form: { class: "d-inline", data: { turbo_confirm: "Delete this entity type?" } } %>
  </div>
</div>
<p class="text-muted"><%= @entity_type.description %></p>

<div class="d-flex justify-content-between align-items-center mb-3 mt-4">
  <h2 class="h5 mb-0">Attributes</h2>
  <%= link_to "New attribute", new_project_entity_type_entity_type_attribute_path(@project, @entity_type),
              class: "btn btn-sm btn-primary" %>
</div>

<% if @entity_type.entity_type_attributes.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Type</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @entity_type.entity_type_attributes.each do |attribute| %>
        <tr>
          <td><%= attribute.name %></td>
          <td><%= attribute.value_type %></td>
          <td>
            <%= link_to "Edit", edit_project_entity_type_entity_type_attribute_path(@project, @entity_type, attribute),
                        class: "btn btn-sm btn-outline-primary" %>
            <%= button_to "Delete", project_entity_type_entity_type_attribute_path(@project, @entity_type, attribute),
                          method: :delete, class: "btn btn-sm btn-outline-danger",
                          form: { class: "d-inline", data: { turbo_confirm: "Delete this attribute?" } } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No attributes defined.</p>
<% end %>

<h2 class="h5 mt-4">Entities</h2>
<% if @entity_type.entities.any? %>
  <ul class="list-unstyled">
    <% @entity_type.entities.each do |entity| %>
      <li><%= link_to entity.label, project_entity_path(@project, entity) %></li>
    <% end %>
  </ul>
<% else %>
  <p class="text-muted">No entities of this type yet.</p>
<% end %>
