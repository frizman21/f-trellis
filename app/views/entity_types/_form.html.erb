<%= form_with model: [ project, entity_type ], local: true do |f| %>
  <% if entity_type.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% entity_type.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :description, class: "form-label" %>
    <%= f.text_area :description, class: "form-control", rows: 3 %>
    <div class="form-text">
      Used as the context for extracting entities of this type from source material. Write it for
      the model that will read it: what counts as one, and what does not.
    </div>
  </div>

  <%= f.submit submit_label, class: "btn btn-primary" %>
  <%= link_to "Cancel", ontology_project_path(@project), class: "btn btn-outline-secondary" %>
<% end %>
