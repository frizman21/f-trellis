<% content_for :title, "Entity Types" %>
<%= render "projects/header", project: @project, side: :ontology %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Entity Types</h1>
  <%= link_to "New entity type", new_project_entity_type_path(@project), class: "btn btn-primary" %>
</div>

<% if @entity_types.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Attributes</th>
        <th>Entities</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @entity_types.each do |entity_type| %>
        <tr>
          <td><%= link_to entity_type.name, project_entity_type_path(@project, entity_type) %></td>
          <td><%= entity_type.description %></td>
          <td><%= entity_type.entity_type_attributes.size %></td>
          <td><%= entity_type.entities.size %></td>
          <td><%= link_to "Edit", edit_project_entity_type_path(@project, entity_type), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No entity types yet.</p>
<% end %>
