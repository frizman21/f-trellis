<% a_detail = @person_a.current_detail %>
<% b_detail = @person_b.current_detail %>
<% a_label = a_detail ? "#{a_detail.first_name} #{a_detail.last_name}" : "Person ##{@person_a.id}" %>
<% b_label = b_detail ? "#{b_detail.first_name} #{b_detail.last_name}" : "Person ##{@person_b.id}" %>
<% content_for :title, "#{a_label} ↔ #{b_label}" %>

<h1>
  <%= a_detail ? "#{a_detail.first_name} #{a_detail.last_name}" : "Person ##{@person_a.id}" %>
  &nbsp;↔&nbsp;
  <%= b_detail ? "#{b_detail.first_name} #{b_detail.last_name}" : "Person ##{@person_b.id}" %>
</h1>

<h2>Parties</h2>
<table class="table">
  <thead>
    <tr>
      <th>Side</th>
      <th>Name</th>
      <th>Type(s)</th>
    </tr>
  </thead>
  <tbody>
    <tr>
      <td>A</td>
      <td><%= link_to (a_detail ? "#{a_detail.first_name} #{a_detail.last_name}" : "Person ##{@person_a.id}"), @person_a %></td>
      <td><%= a_detail&.person_types&.map(&:name)&.join(", ") %></td>
    </tr>
    <tr>
      <td>B</td>
      <td><%= link_to (b_detail ? "#{b_detail.first_name} #{b_detail.last_name}" : "Person ##{@person_b.id}"), @person_b %></td>
      <td><%= b_detail&.person_types&.map(&:name)&.join(", ") %></td>
    </tr>
  </tbody>
</table>

<% if @current %>
  <h2>Current relationship detail</h2>
  <dl>
    <dt>As of</dt><dd><%= @current.as_of&.to_date %></dd>
    <dt>Confidence</dt><dd><%= @current.confidence_tenths.to_i / 10.0 %>%</dd>
    <% if @current.person_person_types.any? %>
      <dt>Types</dt><dd><%= @current.person_person_types.map(&:name).join(", ") %></dd>
    <% end %>
    <% if @current.source_processing_report %>
      <dt>Source</dt>
      <dd>
        <%= link_to @current.source_processing_report.source.url,
                    @current.source_processing_report.source %>
      </dd>
    <% end %>
  </dl>

  <% if @current.additional_attributes.any? %>
    <h3>Additional attributes</h3>
    <table class="table table-sm">
      <tbody>
        <% @current.additional_attributes.each do |key, value| %>
          <tr><th><%= key.humanize %></th><td><%= value %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% else %>
  <p class="text-muted">No current detail set on this relationship.</p>
<% end %>

<% if @details.any? %>
  <h2>Contributing details</h2>
  <table class="table">
    <thead>
      <tr>
        <th></th>
        <th>As of</th>
        <th>Confidence</th>
        <th>Types</th>
        <th>Source</th>
        <th>Additional attributes</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @details.each do |d| %>
        <tr>
          <td>
            <% if d.id == @current&.id %>
              <span class="badge bg-primary">current</span>
            <% end %>
          </td>
          <td><%= d.as_of&.to_date %></td>
          <td><%= d.confidence_tenths.to_i / 10.0 %>%</td>
          <td><%= d.person_person_types.map(&:name).join(", ") %></td>
          <td>
            <% src = d.source_processing_report&.source %>
            <% if src %>
              <%= link_to src.url, src %>
            <% end %>
          </td>
          <td>
            <% if d.additional_attributes.any? %>
              <%= d.additional_attributes.map { |k, v| "#{k.humanize}: #{v}" }.join("; ") %>
            <% end %>
          </td>
          <td><%= link_to "View", person_person_detail_path(d) %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<p>
  <%= link_to "Back to #{a_detail&.first_name || "person A"}", @person_a %> ·
  <%= link_to "Back to #{b_detail&.first_name || "person B"}", @person_b %>
</p>
