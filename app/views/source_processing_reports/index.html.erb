<% content_for :title, "Source Processing Reports" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Source Processing Reports</h1>
  <%= link_to "New report", new_source_processing_report_path, class: "btn btn-primary" %>
</div>

<% if @reports.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>ID</th>
        <th>Status</th>
        <th>Source</th>
        <th>Skill</th>
        <th>Revision</th>
        <th>Model</th>
        <th>Chat</th>
        <th>Facts</th>
        <th>Created</th>
      </tr>
    </thead>
    <tbody>
      <% @reports.each do |report| %>
        <tr>
          <td><%= report.id %></td>
          <td><%= report_status_cell(report) %></td>
          <td>
            <% if report.source %>
              <%= link_to "Source ##{report.source.id}", source_path(report.source) %>
            <% else %>
              —
            <% end %>
          </td>
          <td><%= report.skill_revision&.skill&.name || "—" %></td>
          <td>
            <% if report.skill_revision %>
              <%= link_to "rev #{report.skill_revision.sequence}", skill_revision_path(report.skill_revision) %>
            <% else %>
              —
            <% end %>
          </td>
          <td><%= report.model&.model_id || "—" %></td>
          <td>
            <% if report.chat %>
              <%= link_to "Chat ##{report.chat.id}", chat_path(report.chat) %>
            <% else %>
              —
            <% end %>
          </td>
          <td><%= report.facts.is_a?(Array) ? report.facts.size : (report.facts.is_a?(Hash) ? report.facts.keys.size : 0) %></td>
          <td><%= report.created_at&.to_date %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @reports %>
  <p class="text-muted small">
    Showing <%= @reports.size %> of <%= @reports.total_count %>.
  </p>
<% else %>
  <p>No reports yet.</p>
  <p><%= link_to "Create the first one", new_source_processing_report_path, class: "btn btn-primary" %></p>
<% end %>
