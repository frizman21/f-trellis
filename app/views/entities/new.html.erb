<% content_for :title, "New Entity" %>
<%= render "projects/back", project: @project, side: :data %>
<h1>New <%= @entity.entity_type&.name || "Entity" %></h1>

<% unless @entity.entity_type %>
  <%# Without a type there is nothing to ask about yet, so this is step one of
      two: choose the kind, then fill it in. Arriving with ?type=<slug> skips it. %>
  <p class="text-muted">Choose a type. You will fill in its attributes next.</p>
<% end %>

<%= form_with model: [ @project, @entity ], local: true do |f| %>
  <% if @entity.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @entity.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :entity_type_id, "Entity type", class: "form-label" %>
    <%= f.collection_select :entity_type_id, @project.entity_types, :id, :name,
                            { prompt: "Choose a type" }, class: "form-select", required: true %>
  </div>

  <%# The type's attributes, when the type is already known. %>
  <% if @entity.entity_attribute_values.any? %>
    <%= f.fields_for :entity_attribute_values do |vf| %>
      <% attribute = vf.object.entity_type_attribute %>
      <div class="mb-3">
        <%= vf.label :value, attribute.name, class: "form-label" %>
        <span class="text-muted small">(<%= attribute.value_type %>)</span>
        <%= vf.hidden_field :entity_type_attribute_id, value: attribute.id %>
        <% case attribute.value_type %>
        <% when "int" %>
          <%= vf.number_field :value, value: vf.object.value, step: 1, class: "form-control" %>
        <% when "float" %>
          <%= vf.number_field :value, value: vf.object.value, step: "any", class: "form-control" %>
        <% when "datetime" %>
          <%= vf.datetime_field :value, value: vf.object.value, class: "form-control" %>
        <% else %>
          <%= vf.text_field :value, value: vf.object.value, class: "form-control" %>
        <% end %>

        <%= vf.fields_for :entity_attribute_value_sources do |sf| %>
          <%= render "shared/source_field", f: sf, label: "Source for #{attribute.name} (optional)" %>
        <% end %>
      </div>
    <% end %>
  <% end %>

  <div class="mb-3">
    <%= f.fields_for :entity_sources do |sf| %>
      <%= render "shared/source_field", f: sf, label: "Source for this entity (optional)" %>
    <% end %>
  </div>

  <%= f.submit "Create entity", class: "btn btn-primary" %>
  <%= link_to "Cancel", project_path(@project), class: "btn btn-outline-secondary" %>
<% end %>
