<% content_for :title, @entity.label %>
<%= render "projects/back", project: @project, side: :data %>

<div class="d-flex justify-content-between align-items-center mb-1">
  <h1 class="mb-0"><%= @entity.label %></h1>
  <div>
    <%= link_to "Edit", edit_project_entity_path(@project, @entity), class: "btn btn-sm btn-outline-primary" %>
    <%= button_to "Delete", project_entity_path(@project, @entity), method: :delete,
                  class: "btn btn-sm btn-outline-danger",
                  form: { class: "d-inline", data: { turbo_confirm: "Delete this entity?" } } %>
  </div>
</div>
<p class="text-muted">
  <%= type_with_attributes @entity.entity_type,
                           project_entity_type_path(@project, @entity.entity_type) %>
</p>

<h2 class="h5 mt-4">Attributes</h2>
<% if @rows.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Attribute</th>
        <th>Value</th>
        <th>Cited from</th>
      </tr>
    </thead>
    <tbody>
      <%# Every attribute of the type gets a row, including ones with nothing
          recorded, so the page shows the shape of the type as well as what is
          filled in. %>
      <% @rows.each do |attribute, value| %>
        <tr>
          <td>
            <%= attribute.name %>
            <span class="text-muted small">(<%= attribute.value_type %>)</span>
          </td>
          <td><%= value&.display_value %></td>
          <td>
            <%= render "shared/citations",
                       citations: value ? value.entity_attribute_value_sources.includes(:source) : [] %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">
    <%= link_to @entity.entity_type.name, project_entity_type_path(@project, @entity.entity_type) %>
    defines no attributes yet.
  </p>
<% end %>

<h2 class="h5 mt-4">Relationships</h2>
<% if @relationships.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Direction</th>
        <th>Relationship</th>
        <th>Entity</th>
        <th>Entity type</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @relationships.each do |relationship| %>
        <% other = relationship.other_end(@entity) %>
        <tr>
          <td class="text-muted">
            <%= relationship.from_entity_id == @entity.id ? "→ to" : "← from" %>
          </td>
          <td><%= relationship.relationship_type.name %></td>
          <%# Links to the far end, never back to the page it is on. %>
          <td><%= link_to other.label, project_entity_path(@project, other) %></td>
          <td class="text-muted"><%= other.entity_type.name %></td>
          <td class="text-nowrap">
            <%= link_to "Edit", edit_project_relationship_path(@project, relationship),
                        class: "btn btn-sm btn-outline-primary" %>
            <%= button_to "Remove", project_relationship_path(@project, relationship, entity_id: @entity.id),
                          method: :delete, class: "btn btn-sm btn-outline-danger",
                          form: { class: "d-inline m-0" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No relationships yet.</p>
<% end %>

<% if @candidates.any? && @relationship_types.any? %>
  <%= form_with model: [ @project, @new_relationship ], local: true,
                class: "row g-2 align-items-end",
                data: { controller: "relationship-form" } do |f| %>
    <%= f.hidden_field :from_entity_id, value: @entity.id %>
    <div class="col-auto">
      <%= f.label :relationship_type_id, "Relationship", class: "form-label" %>
      <%# Each option carries the entity type its far end must be, which is what
          the narrowing controller reads. %>
      <%= f.select :relationship_type_id,
                   @relationship_types.map { |t|
                     [ "#{t.name} (→ #{t.to_entity_type.name})", t.id,
                       { data: { to_entity_type_id: t.to_entity_type_id } } ]
                   },
                   { prompt: "Choose a kind" },
                   class: "form-select", required: true,
                   data: { relationship_form_target: "type",
                           action: "change->relationship-form#filter" } %>
    </div>
    <div class="col-auto">
      <%= f.label :to_entity_id, "Relate to", class: "form-label" %>
      <%= f.select :to_entity_id,
                   @candidates.map { |e|
                     [ e.label, e.id, { data: { entity_type_id: e.entity_type_id } } ]
                   },
                   { prompt: "Choose an entity" },
                   class: "form-select", required: true,
                   data: { relationship_form_target: "entity" } %>
    </div>
    <div class="col-12">
      <%= f.fields_for :relationship_sources do |sf| %>
        <%= render "shared/source_field", f: sf, label: "Source for this relationship (optional)" %>
      <% end %>
    </div>
    <div class="col-auto">
      <%= f.submit "Add relationship", class: "btn btn-outline-primary" %>
    </div>
  <% end %>
<% end %>

<% if @candidates.any? && @relationship_types.none? %>
  <p class="text-muted">
    No <%= link_to "relationship type", ontology_project_path(@project) %>
    starts at a <%= @entity.entity_type.name %>, so this entity cannot be connected yet.
  </p>
<% end %>
