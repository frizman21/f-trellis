<% content_for :title, @entity.name %>
<%= render "projects/back", project: @project, side: :data %>

<div class="d-flex justify-content-between align-items-center mb-1">
  <h1 class="mb-0"><%= @entity.name %></h1>
  <div>
    <%= link_to "Edit", edit_project_entity_path(@project, @entity), class: "btn btn-sm btn-outline-primary" %>
    <%= button_to "Delete", project_entity_path(@project, @entity), method: :delete,
                  class: "btn btn-sm btn-outline-danger",
                  form: { class: "d-inline", data: { turbo_confirm: "Delete this entity?" } } %>
  </div>
</div>
<p class="text-muted">
  <%= @entity.entity_type.name %>
  <%# The entity's own citations were recorded and shown nowhere, so "where did
      this thing come from at all?" had no answer on its own page. %>
  <%= pedigree_link @project, @entity %>
</p>

<h2 class="h5 mt-4">Attributes</h2>
<% if @rows.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Attribute</th>
        <th>Value</th>
        <th>Sources</th>
      </tr>
    </thead>
    <tbody>
      <%# Every attribute of the type gets a row, including ones with nothing
          recorded, so the page shows the shape of the type as well as what is
          filled in. %>
      <% @rows.each do |attribute, value| %>
        <tr>
          <td>
            <%= attribute.name %>
            <span class="text-muted small">(<%= attribute.value_type %>)</span>
            <% if attribute.is_disabled? %>
              <span class="badge text-bg-light">disabled</span>
            <% end %>
          </td>
          <%# Whole, not truncated: one value to a row here, and no column width
              to protect. A web address is linked. %>
          <td>
            <%= value_as_link value&.display_value, truncate: nil %>
            <%= pedigree_link @project, value if value %>
          </td>
          <%# The count, not the list. A value seen in six runs used to push the
              row it belongs to off the screen; the pedigree page has room for
              all of them and this column says whether it is worth opening. %>
          <td class="text-muted small">
            <% if value %>
              <%= pluralize value.entity_attribute_value_extraction_runs.size, "sighting" %>
            <% else %>
              —
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">
    <%= link_to @entity.entity_type.name, project_entity_type_path(@project, @entity.entity_type) %>
    defines no attributes yet.
  </p>
<% end %>

<h2 class="h5 mt-4">Relationships</h2>
<% if @relationships.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Relationship</th>
        <th>Direction</th>
        <th>Entity</th>
        <% @relationship_columns.each do |attribute| %>
          <th><%= attribute.name %></th>
        <% end %>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @relationships.each do |relationship| %>
        <% other = relationship.other_end(@entity) %>
        <tr>
          <%# Reads as a sentence: Powers → to → Saturn V → Launch Vehicle. %>
          <td>
            <%= relationship.relationship_type.name %>
            <%= pedigree_link @project, relationship %>
          </td>
          <td class="text-muted">
            <%= relationship.from_entity_id == @entity.id ? "→ to" : "← from" %>
          </td>
          <%# One fact about the far end, not two: "Saturn V, which is a Launch
              Vehicle". Links to the far end, never back to the page it is on;
              the type links to its own list. %>
          <td>
            <%= link_to other.name, project_entity_path(@project, other) %>
            <span class="text-muted">:</span>
            <%= link_to other.entity_type.name,
                        project_typed_entities_path(@project, other.entity_type.slug),
                        class: "text-muted" %>
          </td>
          <% values = relationship.values_by_attribute_id %>
          <% @relationship_columns.each do |attribute| %>
            <% value = values[attribute.id] %>
            <td>
              <%= value_as_link value&.display_value, truncate: 40 %>
              <%= pedigree_link @project, value if value %>
            </td>
          <% end %>
          <td class="text-nowrap">
            <%= link_to "Edit", edit_project_relationship_path(@project, relationship),
                        class: "btn btn-sm btn-outline-primary" %>
            <%= button_to "Remove", project_relationship_path(@project, relationship, entity_id: @entity.id),
                          method: :delete, class: "btn btn-sm btn-outline-danger",
                          form: { class: "d-inline m-0" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No relationships yet.</p>
<% end %>
