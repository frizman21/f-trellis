<% content_for :title, @entity.label %>
<%= render "projects/back", project: @project, side: :data %>

<div class="d-flex justify-content-between align-items-center mb-1">
  <h1 class="mb-0"><%= @entity.label %></h1>
  <div>
    <%= link_to "Edit", edit_project_entity_path(@project, @entity), class: "btn btn-sm btn-outline-primary" %>
    <%= button_to "Delete", project_entity_path(@project, @entity), method: :delete,
                  class: "btn btn-sm btn-outline-danger",
                  form: { class: "d-inline", data: { turbo_confirm: "Delete this entity?" } } %>
  </div>
</div>
<p class="text-muted">
  <%= type_with_attributes @entity.entity_type,
                           project_entity_type_path(@project, @entity.entity_type) %>
</p>

<h2 class="h5 mt-4">Attributes</h2>
<% if @rows.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Attribute</th>
        <th>Value</th>
        <th>Cited from</th>
      </tr>
    </thead>
    <tbody>
      <%# Every attribute of the type gets a row, including ones with nothing
          recorded, so the page shows the shape of the type as well as what is
          filled in. %>
      <% @rows.each do |attribute, value| %>
        <tr>
          <td>
            <%= attribute.name %>
            <span class="text-muted small">(<%= attribute.value_type %>)</span>
          </td>
          <td><%= value&.display_value %></td>
          <td>
            <%= render "shared/citations",
                       citations: value ? value.entity_attribute_value_sources.includes(:source) : [] %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">
    <%= link_to @entity.entity_type.name, project_entity_type_path(@project, @entity.entity_type) %>
    defines no attributes yet.
  </p>
<% end %>

<h2 class="h5 mt-4">Relationships</h2>
<% if @relationships.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Relationship</th>
        <th>Direction</th>
        <th>Entity</th>
        <th>Entity type</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @relationships.each do |relationship| %>
        <% other = relationship.other_end(@entity) %>
        <tr>
          <%# Reads as a sentence: Powers → to → Saturn V → Launch Vehicle. %>
          <td><%= relationship.relationship_type.name %></td>
          <td class="text-muted">
            <%= relationship.from_entity_id == @entity.id ? "→ to" : "← from" %>
          </td>
          <%# Links to the far end, never back to the page it is on. %>
          <td><%= link_to other.label, project_entity_path(@project, other) %></td>
          <td class="text-muted"><%= other.entity_type.name %></td>
          <td class="text-nowrap">
            <%= link_to "Edit", edit_project_relationship_path(@project, relationship),
                        class: "btn btn-sm btn-outline-primary" %>
            <%= button_to "Remove", project_relationship_path(@project, relationship, entity_id: @entity.id),
                          method: :delete, class: "btn btn-sm btn-outline-danger",
                          form: { class: "d-inline m-0" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No relationships yet.</p>
<% end %>
