<% content_for :title, @entity.label %>

<div class="d-flex justify-content-between align-items-center mb-1">
  <h1 class="mb-0"><%= @entity.label %></h1>
  <div>
    <%= link_to "Edit", edit_entity_path(@entity), class: "btn btn-sm btn-outline-primary" %>
    <%= button_to "Delete", entity_path(@entity), method: :delete,
                  class: "btn btn-sm btn-outline-danger",
                  form: { class: "d-inline", data: { turbo_confirm: "Delete this entity?" } } %>
  </div>
</div>
<p class="text-muted">
  <%= link_to @entity.entity_type.name, entity_type_path(@entity.entity_type) %>
</p>

<h2 class="h5 mt-4">Attributes</h2>
<% if @rows.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Attribute</th>
        <th>Value</th>
      </tr>
    </thead>
    <tbody>
      <%# Every attribute of the type gets a row, including ones with nothing
          recorded, so the page shows the shape of the type as well as what is
          filled in. %>
      <% @rows.each do |attribute, value| %>
        <tr>
          <td>
            <%= attribute.name %>
            <span class="text-muted small">(<%= attribute.value_type %>)</span>
          </td>
          <td><%= value&.display_value %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">
    <%= link_to @entity.entity_type.name, entity_type_path(@entity.entity_type) %>
    defines no attributes yet.
  </p>
<% end %>

<h2 class="h5 mt-4">Relationships</h2>
<% if @relationships.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Direction</th>
        <th>Entity</th>
        <th>Type</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @relationships.each do |relationship| %>
        <% other = relationship.other_end(@entity) %>
        <tr>
          <td class="text-muted">
            <%= relationship.from_entity_id == @entity.id ? "→ to" : "← from" %>
          </td>
          <%# Links to the far end, never back to the page it is on. %>
          <td><%= link_to other.label, entity_path(other) %></td>
          <td class="text-muted"><%= other.entity_type.name %></td>
          <td>
            <%= button_to "Remove", relationship_path(relationship, entity_id: @entity.id),
                          method: :delete, class: "btn btn-sm btn-outline-danger",
                          form: { class: "m-0" } %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No relationships yet.</p>
<% end %>

<% if @candidates.any? %>
  <%= form_with model: Relationship.new, local: true, class: "row g-2 align-items-end" do |f| %>
    <%= f.hidden_field :from_entity_id, value: @entity.id %>
    <div class="col-auto">
      <%= f.label :to_entity_id, "Relate to", class: "form-label" %>
      <%= f.collection_select :to_entity_id, @candidates, :id, :label,
                              { prompt: "Choose an entity" }, class: "form-select" %>
    </div>
    <div class="col-auto">
      <%= f.submit "Add relationship", class: "btn btn-outline-primary" %>
    </div>
  <% end %>
<% end %>
