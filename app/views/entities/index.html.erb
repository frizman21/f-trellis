<% content_for :title, "#{@entity_type.name} — #{@project.name}" %>
<p class="mb-3">
  <%= link_to "← #{@project.name}", project_path(@project), class: "text-decoration-none" %>
</p>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0"><%= @entity_type.name %></h1>
  <%# Named for the kind, and carrying it, so the next page can ask for its
      attributes rather than for its type. %>
  <%= link_to "New #{@entity_type.name}",
              new_project_entity_path(@project, type: @entity_type.slug),
              class: "btn btn-primary" %>
</div>

<%# One form holds the whole view — search, sort and page size — so there is a
    single place that knows what is currently being shown, and every one of them
    stays in the query string where a link can carry it. %>
<%= form_with url: url_for(only_path: true), method: :get,
              local: true, class: "row g-2 align-items-center mb-3" do %>
  <%= hidden_field_tag :sort, params[:sort] %>
  <%= hidden_field_tag :dir, params[:dir] %>
  <div class="col-auto">
    <%= text_field_tag :q, @query, class: "form-control",
                       placeholder: "Search #{@entity_type.name.pluralize}…",
                       "aria-label": "Search" %>
  </div>
  <div class="col-auto">
    <%= submit_tag "Search", class: "btn btn-outline-primary", name: nil %>
    <% if @query.present? %>
      <%= link_to "Clear", url_for(sort: params[:sort], dir: params[:dir]),
                  class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
  <div class="col-auto ms-auto d-flex align-items-center gap-2">
    <%= label_tag :per, "Per page", class: "col-form-label text-muted small mb-0" %>
    <%= select_tag :per,
                   options_for_select(EntitiesController::PAGE_SIZES, @per_page),
                   class: "form-select form-select-sm", style: "width: auto;",
                   onchange: "this.form.requestSubmit()" %>
  </div>
<% end %>

<% if @entities.any? %>
  <div class="table-responsive">
    <table class="table">
      <thead>
        <tr>
          <th>
            <%= sort_header_for_name current_attribute: @sort_attribute,
                                     sorted_by_name: @sorted_by_name,
                                     direction: @direction, query: @query %>
          </th>
          <%# A column per attribute the type asks to show. %>
          <% @columns.each do |attribute| %>
            <th>
              <%= sort_header attribute, current_attribute: @sort_attribute,
                              direction: @direction, query: @query %>
            </th>
          <% end %>
        </tr>
      </thead>
      <tbody>
        <% @entities.each do |entity| %>
          <% values = entity.values_by_attribute_id %>
          <tr>
            <td><%= link_to entity.name, project_entity_path(@project, entity) %></td>
            <% @columns.each do |attribute| %>
              <%# Truncated in the cell, not in the data: a string attribute has
                  no length limit, and one long value would otherwise decide the
                  width of every column. A value that is a web address is linked,
                  with the whole address in the href and only the text cut. %>
              <td><%= value_as_link values[attribute.id]&.display_value %></td>
            <% end %>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%# What you are looking at, so the page size means something before you
      change it. %>
  <p class="text-muted small"><%= page_entries_info @entities %></p>
  <%= paginate @entities %>
<% elsif @query.present? %>
  <p>No <%= @entity_type.name %> entities match <%= tag.strong @query %>.</p>
<% else %>
  <p>No <%= @entity_type.name %> entities yet.</p>
<% end %>
