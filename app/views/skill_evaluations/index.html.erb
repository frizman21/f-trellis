<% content_for :title, "Skill Evaluations" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Skill Evaluations</h1>
  <%= link_to "New evaluation", new_skill_evaluation_path, class: "btn btn-primary" %>
</div>

<p class="text-muted">
  An evaluation runs one skill against a set of pages through a set of models,
  and keeps every response side by side. It never writes into the knowledge
  graph — use <%= link_to "processing reports", source_processing_reports_path %>
  for that.
</p>

<% if @evaluations.any? %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>ID</th>
        <th>Name</th>
        <th>Skill</th>
        <th>Learning set</th>
        <th>Base model</th>
        <th>Sources</th>
        <th>Models</th>
        <th>Runs</th>
        <th>Created</th>
      </tr>
    </thead>
    <tbody>
      <% @evaluations.each do |evaluation| %>
        <tr>
          <td><%= evaluation.id %></td>
          <td><%= link_to evaluation.name, skill_evaluation_path(evaluation) %></td>
          <td><%= link_to evaluation.skill.name, skill_path(evaluation.skill) %></td>
          <td><%= link_to evaluation.learning_set.name, learning_set_path(evaluation.learning_set) %></td>
          <td><code><%= evaluation.base_model.model_id %></code></td>
          <td><%= evaluation.sources.size %></td>
          <td><%= evaluation.models.size %></td>
          <td><%= evaluation.skill_evaluation_results.count %> of <%= evaluation.planned_pair_count %></td>
          <td><%= evaluation.created_at&.to_date %></td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @evaluations %>
<% else %>
  <p>No evaluations yet.</p>
  <p><%= link_to "Create the first one", new_skill_evaluation_path, class: "btn btn-primary" %></p>
<% end %>
