<% content_for :title, @evaluation.name %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0"><%= @evaluation.name %></h1>
  <div class="d-flex gap-2">
    <%= link_to "Edit", edit_skill_evaluation_path(@evaluation), class: "btn btn-outline-primary" %>
    <%= button_to "Run evaluation", run_skill_evaluation_path(@evaluation),
                  method: :post, class: "btn btn-primary", form: { class: "m-0" } %>
  </div>
</div>

<% if @evaluation.description.present? %>
  <p><%= @evaluation.description %></p>
<% end %>

<dl class="row">
  <dt class="col-sm-3">Skill</dt>
  <dd class="col-sm-9">
    <%= link_to @evaluation.skill.name, skill_path(@evaluation.skill) %>
    <% if @revision %>
      <span class="text-muted">— runs <%= link_to "revision #{@revision.sequence}", skill_revision_path(@revision) %></span>
    <% else %>
      <span class="text-danger">— no revisions, so there is nothing to run</span>
    <% end %>
  </dd>

  <dt class="col-sm-3">Base model</dt>
  <dd class="col-sm-9">
    <span class="text-muted"><%= @evaluation.base_model.provider %> /</span>
    <code><%= @evaluation.base_model.model_id %></code>
    <div class="text-muted small">
      Everything below is measured against what this model proposes on the same
      page, so it is run whether or not it is ticked.
    </div>
  </dd>

  <dt class="col-sm-3">Models</dt>
  <dd class="col-sm-9">
    <% if @evaluation.models_to_run.any? %>
      <% @evaluation.models_to_run.each do |model| %>
        <div>
          <code><%= model.model_id %></code>
          <span class="text-muted small"><%= model_pricing_label(model) %></span>
          <%= model_capability_badge(model) %>
          <% if model.id == @evaluation.base_model_id %>
            <span class="badge bg-light text-dark border">baseline</span>
          <% end %>
        </div>
      <% end %>
      <div class="text-muted small">
        <% if @evaluation.model_objective.present? %>
          Chosen by objective: <strong><%= @evaluation.model_objective %></strong>.
        <% else %>
          Hand-picked.
        <% end %>
      </div>
      <% dropped = @evaluation.models.select(&:unusable?) %>
      <% if dropped.any? %>
        <div class="text-warning small">
          Not run: <%= dropped.map(&:model_id).to_sentence %> —
          <%= dropped.size == 1 ? "deprecated or disabled" : "all deprecated or disabled" %>.
        </div>
      <% end %>
    <% elsif @evaluation.base_model&.unusable? %>
      <span class="text-danger">
        The baseline <code><%= @evaluation.base_model.model_id %></code> is
        <%= @evaluation.base_model.capability_flag %>, so there is nothing to measure against.
        Pick a different baseline before running.
      </span>
    <% else %>
      <span class="text-muted">None selected.</span>
    <% end %>
  </dd>

  <dt class="col-sm-3">Learning set</dt>
  <dd class="col-sm-9">
    <%= link_to @evaluation.learning_set.name, learning_set_path(@evaluation.learning_set) %>
    <% if @evaluation.sources.any? %>
      <% @evaluation.sources.each do |source| %>
        <div><%= link_to "##{source.id}", source_path(source) %> <%= truncate(source.url.to_s, length: 90) %></div>
      <% end %>
      <div class="text-muted small">
        Pages come from the set. Add one there and it is part of the next run.
      </div>
    <% else %>
      <div class="text-muted">
        The set has no pages yet —
        <%= link_to "add some", learning_set_path(@evaluation.learning_set) %>.
      </div>
    <% end %>
  </dd>

  <dt class="col-sm-3">Pairs</dt>
  <dd class="col-sm-9">
    <%= pluralize(@evaluation.planned_pair_count, "run") %> per revision
    (<%= @evaluation.sources.count %> sources × <%= @evaluation.models_to_run.size %> models).
    Running again only queues pairs that have not been run at the current revision.
  </dd>
</dl>

<h2 class="h4">Results</h2>

<% planned = @evaluation.planned_pair_count %>
<% complete = @counts["complete"].to_i %>
<% failed = @counts["failed"].to_i %>
<div class="card mb-3">
  <div class="card-body">
    <div class="d-flex align-items-center gap-2 mb-2">
      <%= evaluation_run_badge(@evaluation.run_status(counts: @counts, planned: planned)) %>
      <span><%= evaluation_progress_summary(@counts, planned) %></span>
    </div>

    <% if planned.positive? %>
      <div class="progress" role="progressbar" aria-valuemin="0" aria-valuemax="100"
           aria-valuenow="<%= ((complete + failed) * 100.0 / planned).round %>">
        <div class="progress-bar bg-success" style="width: <%= complete * 100.0 / planned %>%"></div>
        <div class="progress-bar bg-danger" style="width: <%= failed * 100.0 / planned %>%"></div>
      </div>
    <% end %>

    <div class="form-text">
      Counted against the current revision<%= " #{@revision.sequence}" if @revision %>.
      Editing the skill starts a fresh set of pairs; earlier revisions stay in the table below.
    </div>

    <% if @evaluation.stalled? %>
      <div class="text-warning-emphasis small mt-2">
        Some pairs have been queued for more than
        <%= distance_of_time_in_words(SkillEvaluation::STALE_AFTER) %> without finishing.
        Their job is more likely gone than slow — queued jobs do not survive a restart
        in development, and nothing re-queues a pair. Editing the skill creates a
        revision, which makes every pair runnable again.
      </div>
    <% end %>
  </div>
</div>

<% if @comparison.any_results? %>
  <%= render "comparison", comparison: @comparison, evaluation: @evaluation %>
<% end %>

<h2 class="h4">Runs</h2>

<% if @results.any? %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Status</th>
        <th>Source</th>
        <th>Model</th>
        <th>Revision</th>
        <th>Contribution</th>
        <th>Response</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @results.each do |result| %>
        <tr>
          <td><%= evaluation_status_badge(result.status) %></td>
          <td>
            <%= link_to "##{result.source.id}", source_path(result.source) %>
            <span class="small text-muted"><%= truncate(result.source.url.to_s, length: 40) %></span>
          </td>
          <td><code><%= result.model.model_id %></code></td>
          <td><%= link_to "rev #{result.skill_revision.sequence}", skill_revision_path(result.skill_revision) %></td>
          <td><%= evaluation_score_label(result) %></td>
          <td class="small">
            <% if result.status == "failed" %>
              <span class="text-danger"><%= truncate(result.error.to_s, length: 80) %></span>
            <% else %>
              <%= truncate(result.response.to_s, length: 80) %>
            <% end %>
          </td>
          <td>
            <%= link_to "Open", skill_evaluation_result_path(result), class: "btn btn-sm btn-outline-primary" %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">
    No runs yet. "Run evaluation" queues one background job per source × model pair.
  </p>
<% end %>

<p><%= link_to "Back to evaluations", skill_evaluations_path %></p>
