<%= form_with model: [ project, relationship_type, attribute ], local: true do |f| %>
  <% if attribute.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% attribute.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :value_type, "Type", class: "form-label" %>
    <%= f.select :value_type, RelationshipTypeAttribute::VALUE_TYPES,
                 { prompt: "Choose a type" }, class: "form-select", required: true %>
    <div class="form-text">
      Decides which column a value is stored in, and what the relationship form offers as an input.
    </div>
  </div>

  <div class="mb-3 form-check">
    <%= f.check_box :is_displayed_on_index, class: "form-check-input" %>
    <%= f.label :is_displayed_on_index, "Show as a column on the relationships list",
                class: "form-check-label" %>
    <div class="form-text">
      Off keeps the attribute recorded and editable, just not shown as a column.
    </div>
  </div>

  <%= f.submit submit_label, class: "btn btn-primary" %>
  <%= link_to "Cancel", project_relationship_type_path(project, relationship_type), class: "btn btn-outline-secondary" %>
<% end %>
