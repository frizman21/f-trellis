<% content_for :title, "Edit Attribute" %>
<%= render "projects/header", project: @project, side: :ontology, section: :relationship_types %>
<h1>Edit <%= @attribute.name %></h1>
<p class="text-muted">On <%= link_to @relationship_type.name, project_relationship_type_path(@project, @relationship_type) %></p>

<%= render "form", project: @project, relationship_type: @relationship_type, attribute: @attribute, submit_label: "Update attribute" %>
