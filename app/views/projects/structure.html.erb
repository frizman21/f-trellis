<% content_for :title, "#{@project.name} — Structure" %>

<%# Both halves on one page: a project's structure is its entity types and the
    relationship types between them, and either alone is half an answer. %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">Entity Types</h1>
  <%= link_to "New entity type", new_project_entity_type_path(@project), class: "btn btn-sm btn-primary" %>
</div>

<% if @entity_types.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Attributes</th>
        <th>Entities</th>
      </tr>
    </thead>
    <tbody>
      <% @entity_types.each do |entity_type| %>
        <tr>
          <td><%= type_with_attributes entity_type, project_entity_type_path(@project, entity_type) %></td>
          <%# Truncated: these are full extraction definitions, and this is a
              list. The whole one is on the type's own page. %>
          <td><%= entity_type.description.to_s.truncate(100) %></td>
          <td><%= entity_type.entity_type_attributes.size %></td>
          <td><%= entity_type.entities.kept.count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No entity types yet.</p>
<% end %>

<div class="d-flex justify-content-between align-items-center mb-3 mt-5">
  <h1 class="h4 mb-0">Relationship Types</h1>
  <%= link_to "New relationship type", new_project_relationship_type_path(@project), class: "btn btn-sm btn-primary" %>
</div>

<% if @relationship_types.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <%# From and To as their own columns rather than one arrow string: they
            are two facts about the type, and read as data this way. %>
        <th>From</th>
        <th>To</th>
        <th>Description</th>
        <th>Attributes</th>
        <th>Relationships</th>
      </tr>
    </thead>
    <tbody>
      <% @relationship_types.each do |relationship_type| %>
        <tr>
          <td><%= type_with_attributes relationship_type, project_relationship_type_path(@project, relationship_type) %></td>
          <td><%= type_with_attributes relationship_type.from_entity_type,
                                       project_entity_type_path(@project, relationship_type.from_entity_type),
                                       css_class: "text-muted" %></td>
          <td><%= type_with_attributes relationship_type.to_entity_type,
                                       project_entity_type_path(@project, relationship_type.to_entity_type),
                                       css_class: "text-muted" %></td>
          <td><%= relationship_type.description.to_s.truncate(100) %></td>
          <td><%= relationship_type.relationship_type_attributes.size %></td>
          <td><%= relationship_type.relationships.kept.count %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No relationship types yet.</p>
<% end %>
