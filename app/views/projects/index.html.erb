<% content_for :title, "Projects" %>
<% content_for :full_width, true %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Projects</h1>
  <%= link_to "New project", new_project_path, class: "btn btn-primary" %>
</div>

<% if @projects.any? %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Name</th>
        <th>Ontology</th>
        <th>Data</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @projects.each do |project| %>
        <tr>
          <td><%= project.name %></td>
          <%# The two sides of a project: what it can describe, and what it has
              recorded. The counts are the useful thing to know before choosing. %>
          <td>
            <%= link_to ontology_project_path(project), class: "btn btn-sm btn-outline-primary" do %>
              Ontology <span class="badge text-bg-secondary"><%= project.entity_types.size %></span>
            <% end %>
          </td>
          <td>
            <%= link_to data_project_path(project), class: "btn btn-sm btn-outline-primary" do %>
              Data <span class="badge text-bg-secondary"><%= project.entities.size %></span>
            <% end %>
          </td>
          <td><%= link_to "Edit", edit_project_path(project), class: "btn btn-sm btn-outline-secondary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No projects yet.</p>
<% end %>
