<%# The two sides of a project. Which project you are in is in the banner, so
    this is only the switch between its two sides. `side` is :ontology or :data. %>
<ul class="nav nav-tabs mb-4">
  <li class="nav-item">
    <%= link_to "Ontology", ontology_project_path(project),
                class: "nav-link #{'active' if side == :ontology}" %>
  </li>
  <li class="nav-item">
    <%= link_to "Data", data_project_path(project),
                class: "nav-link #{'active' if side == :data}" %>
  </li>
</ul>
