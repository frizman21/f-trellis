<%= form_with model: project, local: true do |f| %>
  <% if project.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% project.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :name, class: "form-label" %>
    <%= f.text_field :name, class: "form-control", required: true %>
  </div>

  <div class="mb-3">
    <%= f.label :default_model_id, "Default model", class: "form-label" %>
    <%# Only models the registry says are usable and pickable — the same set the
        skill form offers. %>
    <%= f.collection_select :default_model_id, Model.selectable, :id, :model_id,
                            { include_blank: "None yet" }, class: "form-select" %>
    <div class="form-text">
      Used to read this project's sources. Extraction is unavailable until one is chosen.
    </div>
  </div>

  <div class="mb-3">
    <%= f.label :extraction_attempts, "Extraction attempts", class: "form-label" %>
    <%= f.number_field :extraction_attempts, in: 1..10, step: 1, class: "form-control" %>
    <div class="form-text">
      How many times one extraction call may be sent. One is a single call with no
      retry. Raise it only for an endpoint whose failures are worth repeating — a
      model bills for a generation even when the connection drops before the
      answer arrives.
    </div>
  </div>

  <%= f.submit submit_label, class: "btn btn-primary" %>
  <%= link_to "Cancel", projects_path, class: "btn btn-outline-secondary" %>
<% end %>
