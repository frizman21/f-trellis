<%# The way back from a record page to the side it belongs to.
    `side` is :structure or :data. %>
<p class="mb-3">
  <% if side == :structure %>
    <%= link_to "← Structure", structure_project_path(project), class: "text-decoration-none" %>
  <% else %>
    <%= link_to "← Data", data_project_path(project), class: "text-decoration-none" %>
  <% end %>
</p>
