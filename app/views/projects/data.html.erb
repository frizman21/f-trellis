<% content_for :title, "#{@project.name} — Data" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="h4 mb-0">Entities</h1>
  <%= link_to "New entity", new_project_entity_path(@project), class: "btn btn-primary" %>
</div>

<% if @entities.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Entity</th>
        <th>Type</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @entities.each do |entity| %>
        <tr>
          <td><%= link_to entity.label, project_entity_path(@project, entity) %></td>
          <td><%= type_with_attributes entity.entity_type, project_entity_type_path(@project, entity.entity_type) %></td>
          <td><%= link_to "Edit", edit_project_entity_path(@project, entity), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
  <%= paginate @entities %>
<% else %>
  <p>No entities yet.</p>
<% end %>
