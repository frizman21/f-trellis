<% content_for :title, @project.name %>

<div class="d-flex justify-content-end gap-2 mb-3">
  <%= link_to "Sources", project_sources_path(@project), class: "btn btn-sm btn-outline-secondary" %>
  <%= link_to "AI Configuration", ai_configuration_project_path(@project),
              class: "btn btn-sm btn-outline-secondary" %>
</div>

<%# A card per kind of thing. The first question anyone has of a project's data
    is "show me the people" or "show me the contracts", and a card to click is a
    better answer than a type column to scan. %>
<% if @entity_types.any? %>
  <div class="row g-3">
    <% @entity_types.each do |entity_type| %>
      <div class="col-sm-6 col-lg-4">
        <div class="card h-100">
          <div class="card-body">
            <h2 class="card-title h5 mb-1">
              <%# Plural: a card stands for the collection, not for one of them.
                  No attribute popover here — a card is a way in, and the list it
                  opens shows the attributes as columns anyway. %>
              <%= link_to entity_type.name.pluralize,
                          project_typed_entities_path(@project, entity_type.slug),
                          class: "stretched-link text-decoration-none" %>
            </h2>
            <p class="card-subtitle text-muted small mb-2">
              <%= pluralize @counts.fetch(entity_type.id, 0), "entity", plural: "entities" %>
            </p>
            <%# Truncated: these are full extraction definitions now, and a card is
                a way in rather than the place to read one. %>
            <p class="card-text small text-muted mb-0"><%= entity_type.description.to_s.truncate(100) %></p>
          </div>
        </div>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-muted">
    This project has no entity types yet. Define one in its
    <%= link_to "structure", structure_project_path(@project) %>.
  </p>
<% end %>
