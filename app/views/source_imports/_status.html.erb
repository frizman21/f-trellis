<%# Same badge convention as fetch_outcome_badge on the domain page, rather than
    a second way of showing the same idea. %>
<% classes = {
     "new"      => "bg-secondary",
     "running"  => "bg-info text-dark",
     "complete" => "bg-success",
     "failed"   => "bg-danger"
   } %>
<span class="badge <%= classes.fetch(import.status, "bg-secondary") %>">
  <%= import.status.humanize %>
</span>
