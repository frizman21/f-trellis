<% content_for :title, "Contracts" %>
<h1>Contracts</h1>

<%= form_with url: contracts_path, method: :get, local: true, class: "mb-3" do |f| %>
  <div class="input-group">
    <%= f.text_field :q, value: @query, placeholder: "Search contract numbers, titles or attribute values...", class: "form-control" %>
    <%= f.submit "Search", class: "btn btn-primary" %>
    <% if @query.present? %>
      <%= link_to "Clear", contracts_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
<% end %>

<% searching = @query.present? %>

<% if @contracts.any? %>
  <p class="text-muted small">
    Showing <%= @contracts.size %> of <%= @contracts.total_count %>.
  </p>

  <table class="table">
    <thead>
      <tr>
        <th>Contract</th>
        <th>Title</th>
        <th><%= searching ? "Matched on" : "Types" %></th>
      </tr>
    </thead>
    <tbody>
      <% @contracts.each do |contract| %>
        <% detail = contract.current_detail %>
        <tr>
          <td>
            <%= link_to (detail ? detail.identifier : "Unidentified contract ##{contract.id}"), contract %>
          </td>
          <td><%= detail&.title %></td>
          <td>
            <% if searching %>
              <% reasons = @match_reasons[contract.id] || [] %>
              <% if reasons.any? %>
                <ul class="mb-0">
                  <% reasons.each do |r| %>
                    <li><%= r %></li>
                  <% end %>
                </ul>
              <% end %>
            <% else %>
              <%= detail&.contract_types&.map(&:name)&.join(", ") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @contracts %>
<% else %>
  <p>
    <% if searching %>
      No contracts matched <em><%= @query %></em>.
    <% else %>
      No contracts yet.
    <% end %>
  </p>
<% end %>
