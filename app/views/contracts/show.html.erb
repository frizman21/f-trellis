<% current = @contract.current_detail %>
<% label = current ? current.identifier : "Unidentified contract ##{@contract.id}" %>
<% content_for :title, label %>

<h1><%= label %></h1>

<% if current %>
  <% if current.title.present? %>
    <p class="lead"><%= current.title %></p>
  <% end %>

  <dl>
    <% if current.value_usd.present? %>
      <dt>Value</dt><dd><%= number_to_currency(current.value_usd) %></dd>
    <% end %>
    <dt>Term</dt>
    <dd>
      <% if current.start_date && current.end_date %>
        <%= current.start_date %> to <%= current.end_date %>
      <% elsif current.start_date %>
        <%= current.start_date %> — no end date recorded
      <% else %>
        Not recorded
      <% end %>
    </dd>
    <dt>As of</dt><dd><%= current.as_of&.to_date %></dd>
    <dt>Confidence</dt><dd><%= current.confidence_tenths.to_i / 10.0 %>%</dd>
    <% if current.contract_types.any? %>
      <dt>Types</dt><dd><%= current.contract_types.map(&:name).join(", ") %></dd>
    <% end %>
  </dl>

  <% if current.additional_attributes.any? %>
    <h2>Attributes</h2>
    <table class="table table-sm">
      <tbody>
        <% current.additional_attributes.each do |key, value| %>
          <tr><th><%= key.humanize %></th><td><%= value %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>

<% prior = @contract.contract_details.where.not(id: current&.id).order(as_of: :desc) %>
<% if prior.any? %>
  <h2>Prior details</h2>
  <table class="table">
    <thead>
      <tr><th>Contract</th><th>Title</th><th>Value</th><th>As of</th><th>Confidence</th><th>Attributes</th></tr>
    </thead>
    <tbody>
      <% prior.each do |d| %>
        <tr>
          <td><%= d.identifier %></td>
          <td><%= d.title %></td>
          <td><%= number_to_currency(d.value_usd) if d.value_usd.present? %></td>
          <td><%= d.as_of&.to_date %></td>
          <td><%= d.confidence_tenths.to_i / 10.0 %>%</td>
          <td>
            <% if d.additional_attributes.any? %>
              <%= d.additional_attributes.map { |k, v| "#{k.humanize}: #{v}" }.join("; ") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% organizations = @contract.contract_organizations.includes(:organization, current_detail: :contract_organization_types) %>
<%= render "shared/relationship_table",
      title: "Organizations",
      column_header: "Organization",
      empty_message: "No organizations recorded for this contract.",
      rows: organizations.map { |co|
        org_detail = co.organization.current_detail
        rel_detail = co.current_detail
        {
          name: org_detail ? org_detail.name : "Organization ##{co.organization_id}",
          record: co.organization,
          types: rel_detail&.contract_organization_types&.map(&:name)&.join(", "),
          as_of: rel_detail&.as_of,
          relationship_path: contract_organization_path(co)
        }
      } %>

