          name: person_detail ? "#{person_detail.first_name} #{person_detail.last_name}" : "Person ##{cp.person_id}",
          record: cp.person,
          types: rel_detail&.contract_person_types&.map(&:name)&.join(", "),
          as_of: rel_detail&.as_of,
