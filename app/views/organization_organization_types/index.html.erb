<% content_for :title, "Organization ↔ Organization Types" %>

<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Organization ↔ Organization Types</h1>
  <%= link_to "New relationship type", new_organization_organization_type_path, class: "btn btn-primary" %>
</div>

<% if @organization_organization_types.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Additional attribute keys</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @organization_organization_types.each do |oot| %>
        <tr>
          <td><%= oot.name %></td>
          <td><%= oot.description %></td>
          <td><%= oot.additional_attribute_keys.join(", ") %></td>
          <td><%= link_to "Edit", edit_organization_organization_type_path(oot), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No relationship types defined.</p>
<% end %>
