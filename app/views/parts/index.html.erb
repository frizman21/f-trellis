<h1>Parts</h1>

<%= form_with url: parts_path, method: :get, local: true, class: "mb-3" do |f| %>
  <div class="input-group">
    <%= f.text_field :q, value: @query, placeholder: "Search names or attribute values...", class: "form-control" %>
    <%= f.submit "Search", class: "btn btn-primary" %>
    <% if @query.present? %>
      <%= link_to "Clear", parts_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
<% end %>

<% searching = @query.present? %>

<% if @parts.any? %>
  <p class="text-muted small">
    Showing <%= @parts.size %> of <%= @parts.total_count %>.
  </p>

  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th><%= searching ? "Matched on" : "Types" %></th>
      </tr>
    </thead>
    <tbody>
      <% @parts.each do |part| %>
        <% detail = part.current_detail %>
        <tr>
          <td>
            <%= link_to (detail ? detail.name : "Unnamed part ##{part.id}"), part %>
          </td>
          <td>
            <% if searching %>
              <% reasons = @match_reasons[part.id] || [] %>
              <% if reasons.any? %>
                <ul class="mb-0">
                  <% reasons.each do |r| %>
                    <li><%= r %></li>
                  <% end %>
                </ul>
              <% end %>
            <% else %>
              <%= detail&.part_types&.map(&:name)&.join(", ") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @parts %>
<% else %>
  <p>
    <% if searching %>
      No parts matched <em><%= @query %></em>.
    <% else %>
      No parts yet.
    <% end %>
  </p>
<% end %>
