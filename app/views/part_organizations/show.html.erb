<% part_detail = @part.current_detail %>
<% org_detail  = @organization.current_detail %>
<% part_label = part_detail ? part_detail.name : "Part ##{@part.id}" %>
<% org_label  = org_detail ? org_detail.name : "Organization ##{@organization.id}" %>
<% content_for :title, "#{part_label} ↔ #{org_label}" %>

<h1>
  <%= part_detail ? part_detail.name : "Part ##{@part.id}" %>
  &nbsp;↔&nbsp;
  <%= org_detail ? org_detail.name : "Organization ##{@organization.id}" %>
</h1>

<h2>Parties</h2>
<table class="table">
  <thead><tr><th>Side</th><th>Name</th><th>Type(s)</th></tr></thead>
  <tbody>
    <tr>
      <td>Part</td>
      <td><%= link_to (part_detail ? part_detail.name : "Part ##{@part.id}"), @part %></td>
      <td><%= part_detail&.part_types&.map(&:name)&.join(", ") %></td>
    </tr>
    <tr>
      <td>Organization</td>
      <td><%= link_to (org_detail ? org_detail.name : "Organization ##{@organization.id}"), @organization %></td>
      <td><%= org_detail&.organization_types&.map(&:name)&.join(", ") %></td>
    </tr>
  </tbody>
</table>

<% if @current %>
  <h2>Current relationship detail</h2>
  <dl>
    <dt>As of</dt><dd><%= @current.as_of&.to_date %></dd>
    <dt>Confidence</dt><dd><%= @current.confidence_tenths.to_i / 10.0 %>%</dd>
    <% if @current.part_organization_types.any? %>
      <dt>Types</dt><dd><%= @current.part_organization_types.map(&:name).join(", ") %></dd>
    <% end %>
    <% if @current.source_processing_report %>
      <dt>Source</dt>
      <dd><%= link_to @current.source_processing_report.source.url, @current.source_processing_report.source %></dd>
    <% end %>
  </dl>

  <% if @current.additional_attributes.any? %>
    <h3>Additional attributes</h3>
    <table class="table table-sm">
      <tbody>
        <% @current.additional_attributes.each do |key, value| %>
          <tr><th><%= key.humanize %></th><td><%= value %></td></tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% else %>
  <p class="text-muted">No current detail set on this relationship.</p>
<% end %>

<% if @prior.any? %>
  <h2>Prior relationship details</h2>
  <table class="table">
    <thead><tr><th>As of</th><th>Confidence</th><th>Types</th><th>Additional attributes</th></tr></thead>
    <tbody>
      <% @prior.each do |d| %>
        <tr>
          <td><%= d.as_of&.to_date %></td>
          <td><%= d.confidence_tenths.to_i / 10.0 %>%</td>
          <td><%= d.part_organization_types.map(&:name).join(", ") %></td>
          <td>
            <% if d.additional_attributes.any? %>
              <%= d.additional_attributes.map { |k, v| "#{k.humanize}: #{v}" }.join("; ") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<p>
  <%= link_to "Back to part", @part %> ·
  <%= link_to "Back to organization", @organization %>
</p>
