<div class="d-flex justify-content-between align-items-center mb-3">
  <h1 class="mb-0">Facility Types</h1>
  <%= link_to "New facility type", new_facility_type_path, class: "btn btn-primary" %>
</div>

<% if @facility_types.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Additional attribute keys</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @facility_types.each do |ft| %>
        <tr>
          <td><%= ft.name %></td>
          <td><%= ft.description %></td>
          <td><%= ft.additional_attribute_keys.join(", ") %></td>
          <td><%= link_to "Edit", edit_facility_type_path(ft), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No facility types defined.</p>
<% end %>
