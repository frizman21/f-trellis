<h1>Facility Types</h1>

<% if @facility_types.any? %>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Description</th>
        <th>Additional attribute keys</th>
      </tr>
    </thead>
    <tbody>
      <% @facility_types.each do |ft| %>
        <tr>
          <td><%= ft.name %></td>
          <td><%= ft.description %></td>
          <td><%= ft.additional_attribute_keys.join(", ") %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p>No facility types defined.</p>
<% end %>
