<% person_detail = @person.current_detail %>
<% science_detail = @science.current_detail %>
<% person_label = person_detail ? "#{person_detail.first_name} #{person_detail.last_name}" : "Person ##{@person.id}" %>
<% science_label = science_detail ? science_detail.name : "Science ##{@science.id}" %>
<% content_for :title, "Detail ##{@detail.id} — #{person_label} ↔ #{science_label}" %>

<h1>
  Relationship detail #<%= @detail.id %>
  <% if @is_current %>
    <span class="badge bg-primary">current</span>
  <% end %>
</h1>

<p>
  <%= link_to "#{person_label} ↔ #{science_label}", person_science_path(@edge) %>
</p>

<dl>
  <dt>As of</dt><dd><%= @detail.as_of %></dd>
  <dt>Confidence</dt><dd><%= @detail.confidence_tenths.to_i / 10.0 %>%</dd>
  <% if @detail.person_science_types.any? %>
    <dt>Types</dt><dd><%= @detail.person_science_types.map(&:name).join(", ") %></dd>
  <% end %>
  <dt>Recorded</dt><dd><%= @detail.created_at %></dd>
  <% if @detail.source_processing_report %>
    <dt>Source</dt>
    <dd>
      <%= link_to @detail.source_processing_report.source.url,
                  @detail.source_processing_report.source %>
    </dd>
    <dt>Skill revision</dt>
    <dd>
      <% rev = @detail.source_processing_report.skill_revision %>
      <% if rev %>
        <%= link_to "#{rev.skill.name} (rev #{rev.sequence})", skill_revision_path(rev) %>
      <% end %>
    </dd>
  <% end %>
</dl>

<% if @detail.additional_attributes.any? %>
  <h2>Additional attributes</h2>
  <table class="table table-sm">
    <tbody>
      <% @detail.additional_attributes.each do |key, value| %>
        <tr><th><%= key.humanize %></th><td><%= value %></td></tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<p><%= link_to "Back to relationship", person_science_path(@edge) %></p>
