<% current = @person.current_detail %>
<% content_for :title, (current ? "#{current.first_name} #{current.last_name}" : "Unnamed person ##{@person.id}") %>

<h1><%= current ? "#{current.first_name} #{current.last_name}" : "Unnamed person ##{@person.id}" %></h1>

<% if current %>
  <dl>
    <dt>As of</dt><dd><%= current.as_of&.to_date %></dd>
    <dt>Confidence</dt><dd><%= current.confidence_tenths.to_i / 10.0 %>%</dd>
    <% if current.person_types.any? %>
      <dt>Types</dt><dd><%= current.person_types.map(&:name).join(", ") %></dd>
    <% end %>
  </dl>

  <% if current.additional_attributes.any? %>
    <h2>Attributes</h2>
    <table class="table table-sm">
      <tbody>
        <% current.additional_attributes.each do |key, value| %>
          <tr>
            <th><%= key.humanize %></th>
            <td><%= value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>

<% prior = @person.person_details.where.not(id: current&.id).order(as_of: :desc) %>
<% if prior.any? %>
  <h2>Prior details</h2>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>As of</th>
        <th>Confidence</th>
        <th>Attributes</th>
      </tr>
    </thead>
    <tbody>
      <% prior.each do |d| %>
        <tr>
          <td><%= d.first_name %> <%= d.last_name %></td>
          <td><%= d.as_of&.to_date %></td>
          <td><%= d.confidence_tenths.to_i / 10.0 %>%</td>
          <td>
            <% if d.additional_attributes.any? %>
              <%= d.additional_attributes.map { |k, v| "#{k.humanize}: #{v}" }.join("; ") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% organizations = @person.person_organizations.includes(:organization, current_detail: :person_organization_types) %>
<%= render "shared/relationship_table",
      title: "Organizations",
      column_header: "Organization",
      empty_message: "No organizations recorded for this person.",
      rows: organizations.map { |po|
        org_detail = po.organization.current_detail
        rel_detail = po.current_detail
        {
          name: org_detail ? org_detail.name : "Organization ##{po.organization_id}",
          record: po.organization,
          types: rel_detail&.person_organization_types&.map(&:name)&.join(", "),
          as_of: rel_detail&.as_of,
          relationship_path: person_organization_path(po)
        }
      } %>

<% person_relationships = @person.person_people.includes(:person_a, :person_b, current_detail: :person_person_types) %>
<%= render "shared/relationship_table",
      title: "Related people",
      column_header: "Person",
      empty_message: "No relationships to other people recorded for this person.",
      rows: person_relationships.map { |pp|
        other = pp.other_person(@person)
        other_detail = other&.current_detail
        rel_detail = pp.current_detail
        {
          name: other_detail ? "#{other_detail.first_name} #{other_detail.last_name}" : "Person ##{other&.id}",
          record: other,
          types: rel_detail&.person_person_types&.map(&:name)&.join(", "),
          as_of: rel_detail&.as_of,
          relationship_path: person_person_path(pp)
        }
      } %>

<% sciences = @person.person_sciences.includes(:science, current_detail: :person_science_types) %>
<%= render "shared/relationship_table",
      title: "Sciences",
      column_header: "Science",
      empty_message: "No sciences recorded for this person.",
      rows: sciences.map { |ps|
        science_detail = ps.science.current_detail
        rel_detail = ps.current_detail
        {
          name: science_detail ? science_detail.name : "Science ##{ps.science_id}",
          record: ps.science,
          types: rel_detail&.person_science_types&.map(&:name)&.join(", "),
          as_of: rel_detail&.as_of,
          relationship_path: person_science_path(ps)
        }
      } %>

<p><%= link_to "Back to people", people_path %></p>
