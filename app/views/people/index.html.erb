<% content_for :title, "People" %>
<h1>People</h1>

<%= form_with url: people_path, method: :get, local: true, class: "mb-3" do |f| %>
  <div class="input-group">
    <%= f.text_field :q, value: @query, placeholder: "Search names or attribute values...", class: "form-control" %>
    <%= f.submit "Search", class: "btn btn-primary" %>
    <% if @query.present? %>
      <%= link_to "Clear", people_path, class: "btn btn-outline-secondary" %>
    <% end %>
  </div>
<% end %>

<% searching = @query.present? %>

<% if @people.any? %>
  <p class="text-muted small">
    Showing <%= @people.size %> of <%= @people.total_count %>.
  </p>

  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th><%= searching ? "Matched on" : "Types" %></th>
      </tr>
    </thead>
    <tbody>
      <% @people.each do |person| %>
        <% detail = person.current_detail %>
        <tr>
          <td>
            <%= link_to (detail ? "#{detail.first_name} #{detail.last_name}" : "Unnamed person ##{person.id}"), person %>
          </td>
          <td>
            <% if searching %>
              <% reasons = @match_reasons[person.id] || [] %>
              <% if reasons.any? %>
                <ul class="mb-0">
                  <% reasons.each do |r| %>
                    <li><%= r %></li>
                  <% end %>
                </ul>
              <% end %>
            <% else %>
              <%= detail&.person_types&.map(&:name)&.join(", ") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>

  <%= paginate @people %>
<% else %>
  <p>
    <% if searching %>
      No people matched <em><%= @query %></em>.
    <% else %>
      No people yet.
    <% end %>
  </p>
<% end %>
