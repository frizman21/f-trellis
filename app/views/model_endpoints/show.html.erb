<% content_for :title, @endpoint.name %>
<p class="mb-3">
  <%= link_to "← Model Endpoints", model_endpoints_path, class: "text-decoration-none" %>
</p>

<h1 class="h4 mb-3"><%= @endpoint.name %></h1>

<dl class="row">
  <dt class="col-sm-3">Base URL</dt>
  <dd class="col-sm-9"><code><%= @endpoint.base_url %></code></dd>

  <dt class="col-sm-3">Token</dt>
  <dd class="col-sm-9"><%= render "model_endpoints/token_state", endpoint: @endpoint %></dd>

  <dt class="col-sm-3">Provider</dt>
  <dd class="col-sm-9">
    <code>custom_endpoint</code>
    <span class="text-muted small">
      — its own provider, so a model id here cannot collide with a registered
      OpenAI one of the same name.
    </span>
  </dd>
</dl>

<div class="d-flex gap-2 mb-4">
  <%= button_to "Check", check_model_endpoint_path(@endpoint), method: :post,
                class: "btn btn-outline-primary" %>
  <%= link_to "Edit", edit_model_endpoint_path(@endpoint), class: "btn btn-outline-secondary" %>
  <%= button_to "Delete", @endpoint, method: :delete, class: "btn btn-outline-danger",
                form: { data: { turbo_confirm: "Remove #{@endpoint.name}?" } } %>
</div>
<p class="form-text mt-0">
  Check asks the endpoint for its model list. It costs nothing and it is the same
  request a run would fail on first, so a wrong address or an unset variable shows
  up here rather than in a failed run hours later.
</p>

<h2 class="h5 mt-4">Models</h2>
<p class="text-muted small">
  The ids this endpoint serves, exactly as it names them. Each becomes an ordinary
  model in the registry and is offered wherever a model is picked — a project's
  default, the extract dropdown, skills, triage and evaluations.
</p>

<% if @models.any? %>
  <table class="table align-middle">
    <thead>
      <tr>
        <th>Model id</th>
        <th>Name</th>
        <th>Status</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% @models.each do |model| %>
        <tr>
          <td><code><%= model.model_id %></code></td>
          <td><%= model.name %></td>
          <td>
            <% if model.unusable? %>
              <span class="text-muted"><%= model.is_deprecated? ? "deprecated" : "disabled" %></span>
            <% else %>
              <span class="text-success">offered</span>
            <% end %>
          </td>
          <%# Models are never deleted — chats, runs, reports and skills point at
              them — so one that is finished with is disabled on its own page. %>
          <td><%= link_to "Edit", edit_model_path(model), class: "btn btn-sm btn-outline-secondary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% else %>
  <p class="text-muted">No models on this endpoint yet.</p>
<% end %>

<%= form_with model: [@endpoint, @model], url: model_endpoint_models_path(@endpoint),
              local: true, class: "mt-3" do |f| %>
  <% if @model.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% @model.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="row g-3 align-items-end">
    <div class="col-md-4">
      <%= f.label :model_id, "Model id", class: "form-label" %>
      <%= f.text_field :model_id, class: "form-control", placeholder: "acme-large" %>
    </div>
    <div class="col-md-4">
      <%= f.label :name, "Name", class: "form-label" %>
      <%= f.text_field :name, class: "form-control", placeholder: "Acme Large" %>
    </div>
    <div class="col-md-3">
      <%= f.submit "Add model", class: "btn btn-primary" %>
    </div>
  </div>
  <div class="form-text">
    The id is what goes on the wire, so it has to match what the endpoint calls
    the model. The name is only what you read; it defaults to the id.
  </div>
<% end %>
