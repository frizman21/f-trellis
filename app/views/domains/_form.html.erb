<%= form_with model: domain, local: true do |f| %>
  <% if domain.errors.any? %>
    <div class="alert alert-danger">
      <ul class="mb-0">
        <% domain.errors.full_messages.each do |m| %>
          <li><%= m %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="mb-3">
    <%= f.label :min_crawl_delay_seconds, "Minimum crawl delay (seconds)", class: "form-label" %>
    <%= f.number_field :min_crawl_delay_seconds, min: 0, step: 1, class: "form-control" %>
    <div class="form-text">
      Minimum number of seconds the crawler should wait between requests to this domain. Leave blank to use the crawler's default.
    </div>
  </div>

  <%= f.submit "Save changes", class: "btn btn-primary" %>
  <%= link_to "Cancel", domains_path, class: "btn btn-outline-secondary" %>
<% end %>
