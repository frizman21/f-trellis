<% current = @organization.current_detail %>
<% content_for :title, (current ? current.name : "Unnamed organization ##{@organization.id}") %>

<h1><%= current ? current.name : "Unnamed organization ##{@organization.id}" %></h1>

<% if current %>
  <dl>
    <dt>As of</dt><dd><%= current.as_of&.to_date %></dd>
    <dt>Confidence</dt><dd><%= current.confidence_tenths.to_i / 10.0 %>%</dd>
    <% if current.organization_types.any? %>
      <dt>Types</dt><dd><%= current.organization_types.map(&:name).join(", ") %></dd>
    <% end %>
  </dl>

  <% if current.additional_attributes.any? %>
    <h2>Attributes</h2>
    <table class="table table-sm">
      <tbody>
        <% current.additional_attributes.each do |key, value| %>
          <tr>
            <th><%= key.humanize %></th>
            <td><%= value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>

<% prior = @organization.organization_details.where.not(id: current&.id).order(as_of: :desc) %>
<% if prior.any? %>
  <h2>Prior details</h2>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>As of</th>
        <th>Confidence</th>
        <th>Attributes</th>
      </tr>
    </thead>
    <tbody>
      <% prior.each do |d| %>
        <tr>
          <td><%= d.name %></td>
          <td><%= d.as_of&.to_date %></td>
          <td><%= d.confidence_tenths.to_i / 10.0 %>%</td>
          <td>
            <% if d.additional_attributes.any? %>
              <%= d.additional_attributes.map { |k, v| "#{k.humanize}: #{v}" }.join("; ") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% people_links = @organization.person_organizations.includes(:person, current_detail: :person_organization_types) %>
<% if people_links.any? %>
  <h2>People</h2>
  <table class="table">
    <thead>
      <tr>
        <th>Person</th>
        <th>Types</th>
        <th>As of</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% people_links.each do |po| %>
        <% person_detail = po.person.current_detail %>
        <% rel_detail = po.current_detail %>
        <tr>
          <td>
            <%= link_to (person_detail ? "#{person_detail.first_name} #{person_detail.last_name}" : "Person ##{po.person_id}"), po.person %>
          </td>
          <td><%= rel_detail&.person_organization_types&.map(&:name)&.join(", ") %></td>
          <td><%= rel_detail&.as_of&.to_date %></td>
          <td><%= link_to "Relationship", person_organization_path(po), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% org_relationships = @organization.organization_organizations.includes(:organization_a, :organization_b, current_detail: :organization_organization_types) %>
<% if org_relationships.any? %>
  <h2>Related organizations</h2>
  <table class="table">
    <thead>
      <tr>
        <th>Organization</th>
        <th>Types</th>
        <th>As of</th>
        <th></th>
      </tr>
    </thead>
    <tbody>
      <% org_relationships.each do |oo| %>
        <% other = oo.other_organization(@organization) %>
        <% other_detail = other&.current_detail %>
        <% rel_detail = oo.current_detail %>
        <tr>
          <td>
            <%= link_to (other_detail ? other_detail.name : "Organization ##{other&.id}"), other %>
          </td>
          <td><%= rel_detail&.organization_organization_types&.map(&:name)&.join(", ") %></td>
          <td><%= rel_detail&.as_of&.to_date %></td>
          <td><%= link_to "Relationship", organization_organization_path(oo), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% part_links = @organization.part_organizations.includes(:part, current_detail: :part_organization_types) %>
<% if part_links.any? %>
  <h2>Parts</h2>
  <table class="table">
    <thead>
      <tr><th>Part</th><th>Types</th><th>As of</th><th></th></tr>
    </thead>
    <tbody>
      <% part_links.each do |po| %>
        <% part_detail = po.part.current_detail %>
        <% rel_detail = po.current_detail %>
        <tr>
          <td><%= link_to (part_detail ? part_detail.name : "Part ##{po.part_id}"), po.part %></td>
          <td><%= rel_detail&.part_organization_types&.map(&:name)&.join(", ") %></td>
          <td><%= rel_detail&.as_of&.to_date %></td>
          <td><%= link_to "Relationship", part_organization_path(po), class: "btn btn-sm btn-outline-primary" %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<p><%= link_to "Back to organizations", organizations_path %></p>
