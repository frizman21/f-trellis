<% current = @organization.current_detail %>
<% content_for :title, (current ? current.name : "Unnamed organization ##{@organization.id}") %>

<h1>
  <%= current ? current.name : "Unnamed organization ##{@organization.id}" %>
  <% if current&.acronym.present? %>
    <small class="text-muted">(<%= current.acronym %>)</small>
  <% end %>
</h1>

<p><%= link_to "Edit", edit_organization_path(@organization), class: "btn btn-sm btn-outline-primary" %></p>

<% if current %>
  <dl>
    <dt>Acronym</dt><dd><%= current.acronym.presence || "—" %></dd>
    <dt>As of</dt><dd><%= current.as_of&.to_date %></dd>
    <dt>Confidence</dt><dd><%= current.confidence_tenths.to_i / 10.0 %>%</dd>
    <% if current.organization_types.any? %>
      <dt>Types</dt><dd><%= current.organization_types.map(&:name).join(", ") %></dd>
    <% end %>
  </dl>

  <% if current.additional_attributes.any? %>
    <h2>Attributes</h2>
    <table class="table table-sm">
      <tbody>
        <% current.additional_attributes.each do |key, value| %>
          <tr>
            <th><%= key.humanize %></th>
            <td><%= value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>

<% prior = @organization.organization_details.where.not(id: current&.id).order(as_of: :desc) %>
<% if prior.any? %>
  <h2>Prior details</h2>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>Acronym</th>
        <th>As of</th>
        <th>Confidence</th>
        <th>Attributes</th>
      </tr>
    </thead>
    <tbody>
      <% prior.each do |d| %>
        <tr>
          <td><%= d.name %></td>
          <td><%= d.acronym %></td>
          <td><%= d.as_of&.to_date %></td>
          <td><%= d.confidence_tenths.to_i / 10.0 %>%</td>
          <td>
            <% if d.additional_attributes.any? %>
              <%= d.additional_attributes.map { |k, v| "#{k.humanize}: #{v}" }.join("; ") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% people_links = @organization.person_organizations.includes(:person, current_detail: :person_organization_types) %>
<%= render "shared/relationship_table",
      title: "People",
      column_header: "Person",
      empty_message: "No people recorded for this organization.",
      rows: people_links.map { |po|
        person_detail = po.person.current_detail
        rel_detail = po.current_detail
        {
          name: person_detail ? "#{person_detail.first_name} #{person_detail.last_name}" : "Person ##{po.person_id}",
          record: po.person,
          types: rel_detail&.person_organization_types&.map(&:name)&.join(", "),
          as_of: rel_detail&.as_of,
          relationship_path: person_organization_path(po)
        }
      } %>

<% org_relationships = @organization.organization_organizations.includes(:organization_a, :organization_b, current_detail: :organization_organization_types) %>
<%= render "shared/relationship_table",
      title: "Related organizations",
      column_header: "Organization",
      empty_message: "No relationships to other organizations recorded for this organization.",
      rows: org_relationships.map { |oo|
        other = oo.other_organization(@organization)
        other_detail = other&.current_detail
        rel_detail = oo.current_detail
        {
          name: other_detail ? other_detail.name : "Organization ##{other&.id}",
          record: other,
          types: rel_detail&.organization_organization_types&.map(&:name)&.join(", "),
          as_of: rel_detail&.as_of,
          relationship_path: organization_organization_path(oo)
        }
      } %>

<% part_links = @organization.part_organizations.includes(:part, current_detail: :part_organization_types) %>
<%= render "shared/relationship_table",
      title: "Parts",
      column_header: "Part",
      empty_message: "No parts recorded for this organization.",
      rows: part_links.map { |po|
        part_detail = po.part.current_detail
        rel_detail = po.current_detail
        {
          name: part_detail ? part_detail.name : "Part ##{po.part_id}",
          record: po.part,
          types: rel_detail&.part_organization_types&.map(&:name)&.join(", "),
          as_of: rel_detail&.as_of,
          relationship_path: part_organization_path(po)
        }
      } %>

<p><%= link_to "Back to organizations", organizations_path %></p>
