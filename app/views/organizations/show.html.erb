<% current = @organization.current_detail %>

<h1><%= current ? current.name : "Unnamed organization ##{@organization.id}" %></h1>

<% if current %>
  <dl>
    <dt>As of</dt><dd><%= current.as_of&.to_date %></dd>
    <dt>Confidence</dt><dd><%= current.confidence_tenths.to_i / 10.0 %>%</dd>
    <% if current.organization_types.any? %>
      <dt>Types</dt><dd><%= current.organization_types.map(&:name).join(", ") %></dd>
    <% end %>
  </dl>

  <% if current.additional_attributes.any? %>
    <h2>Attributes</h2>
    <table class="table table-sm">
      <tbody>
        <% current.additional_attributes.each do |key, value| %>
          <tr>
            <th><%= key.humanize %></th>
            <td><%= value %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
<% end %>

<% prior = @organization.organization_details.where.not(id: current&.id).order(as_of: :desc) %>
<% if prior.any? %>
  <h2>Prior details</h2>
  <table class="table">
    <thead>
      <tr>
        <th>Name</th>
        <th>As of</th>
        <th>Confidence</th>
        <th>Attributes</th>
      </tr>
    </thead>
    <tbody>
      <% prior.each do |d| %>
        <tr>
          <td><%= d.name %></td>
          <td><%= d.as_of&.to_date %></td>
          <td><%= d.confidence_tenths.to_i / 10.0 %>%</td>
          <td>
            <% if d.additional_attributes.any? %>
              <%= d.additional_attributes.map { |k, v| "#{k.humanize}: #{v}" }.join("; ") %>
            <% end %>
          </td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<% people_links = @organization.person_organizations.includes(:person, current_detail: :person_organization_types) %>
<% if people_links.any? %>
  <h2>People</h2>
  <table class="table">
    <thead>
      <tr>
        <th>Person</th>
        <th>Types</th>
        <th>As of</th>
      </tr>
    </thead>
    <tbody>
      <% people_links.each do |po| %>
        <% person_detail = po.person.current_detail %>
        <% rel_detail = po.current_detail %>
        <tr>
          <td>
            <%= link_to (person_detail ? "#{person_detail.first_name} #{person_detail.last_name}" : "Person ##{po.person_id}"), po.person %>
          </td>
          <td><%= rel_detail&.person_organization_types&.map(&:name)&.join(", ") %></td>
          <td><%= rel_detail&.as_of&.to_date %></td>
        </tr>
      <% end %>
    </tbody>
  </table>
<% end %>

<p><%= link_to "Back to organizations", organizations_path %></p>
