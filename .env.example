# Copy to .env and fill in as needed. .env is gitignored.

# Host port the web container is published on (container always listens on 3000).
# Change this when running a second checkout alongside this one so the two
# don't fight over the same host port.
WEB_PORT=3001

# LLM provider API keys (loaded by docker-compose into the web container).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=

# Tokens for custom model endpoints — models served from somewhere the provider
# registry never looks. Add one line per endpoint.
#
# The variable name is yours to choose: a ModelEndpoint stores the *name* of the
# variable, never the token, so whatever you type into its "Token variable"
# field has to be a variable set here. Add the endpoint under Model Endpoints in
# the sidebar, then press Check on it — that confirms the address and this token
# in one request, before anything spends on a run.
#
# ACME_PAT=

# What the crawler tells a server it is. Both are optional; the defaults are
# "f-agents/<commit>" and "https://github.com/f-agents", which is a real public
# page an operator can reach. Set CRAWLER_CONTACT_URL to an empty value to send
# no contact URL at all. See "The crawler's identity" in the README.
CRAWLER_USER_AGENT=
CRAWLER_CONTACT_URL=
