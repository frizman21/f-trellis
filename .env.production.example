# Production environment variables. Copy to `.env.production` and fill in.
# Never commit `.env.production` — it is in `.gitignore`.

# Required: contents of `config/master.key` for the production environment.
# Used to decrypt `config/credentials.yml.enc`.
RAILS_MASTER_KEY=

# Required: password for the `app` Postgres role. Generate with e.g.
# `openssl rand -hex 32`.
APP_DATABASE_PASSWORD=

# Optional: host port for the Rails app. Bind to a loopback or private
# interface in your reverse-proxy setup; do not expose 80/443 directly.
APP_HTTP_PORT=80

# Optional: Puma tuning. RAILS_MAX_THREADS also controls the DB pool size.
RAILS_MAX_THREADS=5
WEB_CONCURRENCY=2

# Optional: image tag used by `app` and `worker`. Bump after building a new
# image so both services pull the same version.
APP_VERSION=latest
