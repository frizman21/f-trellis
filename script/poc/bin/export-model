#!/usr/bin/env ruby
# frozen_string_literal: true

# Stage 0 — take the mental model out of the application.
#
# The project's structure already exists in the database, and ExtractionPrompt
# already turns it into instructions a model can follow. This writes both forms
# to the input directory: instructions.md, which is what gets sent, and
# mental-model.json, which is what the validator and scorer judge replies
# against. Two files rather than one because they have different owners after
# this point — the prose is meant to be edited by hand and the structure is not.
#
#   docker compose exec web bundle exec ruby script/poc/bin/export-model --project 4 --urls
#
# instructions.md is never overwritten without --force. Finding a better prompt
# is the point of the exercise, and a re-export that silently reverted an
# afternoon of prompt edits would destroy the only thing being learned.

require "optparse"
require_relative "../lib/poc"

options = { urls: false, force: false }

OptionParser.new do |opts|
  opts.banner = "Usage: export-model --project ID_OR_NAME [--urls] [--force]"
  opts.on("--project ID_OR_NAME", "Project to export the mental model from") { |v| options[:project] = v }
  opts.on("--urls", "Also write urls.txt from the project's sources") { options[:urls] = true }
  opts.on("--force", "Overwrite instructions.md and mental-model.json if they exist") { options[:force] = true }
  opts.on("--work PATH", "Work directory (default script/poc/work)") { |v| Poc.work = v }
  opts.on("-h", "--help") { puts opts; exit }
end.parse!

abort "--project is required" if options[:project].to_s.empty?

require_relative "../../../config/environment"

project = if options[:project].match?(/\A\d+\z/)
            Project.find_by(id: options[:project])
          else
            Project.find_by(name: options[:project])
          end

abort "no project matching #{options[:project].inspect}" if project.nil?

prompt = ExtractionPrompt.new(project)
abort "project #{project.name.inspect} defines no entity or relationship types" if prompt.empty?

Poc.mkdir(Poc.stage_dir(:input))

# Attributes are exported with their value type because that is what the
# validator needs to say an attribute is wrong rather than merely unrecognised.
def attributes_for(collection)
  collection.active.map { |a| { "name" => a.name, "value_type" => a.value_type } }
end

mental_model = {
  "exported_at" => Time.current.iso8601,
  "project" => { "id" => project.id, "name" => project.name },
  "entity_types" => prompt.entity_types.map do |type|
    {
      "name" => type.name,
      "description" => type.description.to_s,
      "attributes" => attributes_for(type.entity_type_attributes)
    }
  end,
  "relationship_types" => prompt.relationship_types.map do |type|
    {
      "name" => type.name,
      "description" => type.description.to_s,
      "from" => type.from_entity_type.name,
      "to" => type.to_entity_type.name,
      "attributes" => attributes_for(type.relationship_type_attributes)
    }
  end,
  "schema" => JSON.parse(prompt.schema_json),
  "example" => prompt.example
}

def guard(path, force)
  return true unless File.exist?(path)
  return true if force

  warn "kept existing #{path} (--force to overwrite)"
  false
end

if guard(Poc.mental_model_file, options[:force])
  Poc.write_json(Poc.mental_model_file, mental_model)
  puts "wrote #{Poc.mental_model_file}"
end

if guard(Poc.instructions_file, options[:force])
  header = <<~MD
    <!--
    Generated by script/poc/bin/export-model from project #{project.id} #{project.name.inspect}
    at #{Time.current.iso8601}, via ExtractionPrompt.

    llm-process sends everything below this comment as the model's instructions,
    verbatim. Edit it freely — trying a different prompt against the same sources
    is the point. export-model will not overwrite your edits without --force.

    If you change what the reply must look like, change mental-model.json's schema
    too, or the validator will hold the model to a contract it was never given.
    -->
  MD

  File.write(Poc.instructions_file, "#{header}\n#{prompt}\n")
  puts "wrote #{Poc.instructions_file} (#{prompt.to_s.length} chars, ~#{prompt.to_s.length / 4} tokens)"
end

if options[:urls]
  if guard(Poc.urls_file, options[:force])
    urls = project.sources.order(:id).filter_map { |s| s.url.presence }.uniq

    File.write(Poc.urls_file, <<~TXT)
      # Sources for project #{project.id} #{project.name.inspect}, exported #{Time.current.iso8601}.
      #
      # Position in this file assigns each URL its number: the first URL is 000,
      # the second 001, and so on. Blank lines and comments are ignored, so they
      # cost nothing. APPEND new URLs at the end — inserting one renumbers
      # everything below it, which orphans every fetched page, extraction, golden
      # and score already carrying those numbers. fetch refuses to run when that
      # happens rather than quietly rewriting history.
      #{urls.join("\n")}
    TXT

    puts "wrote #{Poc.urls_file} (#{urls.size} urls)"
  end
end

puts
puts "entity types:       #{mental_model['entity_types'].size}"
puts "relationship types: #{mental_model['relationship_types'].size}"
